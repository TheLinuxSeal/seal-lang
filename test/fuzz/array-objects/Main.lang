// Fuzz input: run-time-sized arrays of numbers, strings and objects, lent, moved, copied and sliced.
struct Main
{
    static void bump(array<int> xs) { for (int i = 0; i < xs.length(); i += 1) { xs[i] += i; } }

    static array<string> names(int n)
    {
        array<string> out = new array<string>(n);
        for (int i = 0; i < n; i += 1) { out[i] = "item" + i; }
        return out;
    }

    static int main()
    {
        array<int> xs = new array<int>(6);
        xs.fill(2);
        bump(xs);
        int total = 0;
        for (int x : xs) { total += x; }
        array<string> ns = names(4);
        ns[1] = ns[1] + "!";
        array<string> part = ns.slice(1, 3);
        part.reverse();
        List<int> asList = xs.toList();
        array<int> back = asList.toArray();
        back.sort();
        array<Box<int>> boxes = new array<Box<int>>(3);
        for (int i = 0; i < 3; i += 1) { boxes[i] = new Box<int>(i * 10); }
        boxes[0] = boxes[2];
        int boxed = 0;
        for (Box<int> b : boxes) { boxed += b.value; }
        array<char> cs = "hello".toCharArray();
        cs[0] = 'j';
        System.stdout.println(total + " " + part[0] + " " + back[5] + " " + boxed + " " + cs[0] + cs.length());
        return 0;
    }
}
