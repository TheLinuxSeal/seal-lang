struct Main
{
    static void punch(Ticket t) { t.id += 100; }
    static Ticket issue(int i) { Ticket t = new Ticket(i); return t; }
    static int idOf(Ticket t) { return t.id; }

    static int main()
    {
        Ticket t = new Ticket(1);
        punch(t);
        t = new Ticket(2);
        Ticket u = issue(3);
        int x = idOf(new Ticket(4));
        Desk d = new Desk();
        d.swapIn(5);
        punch(d.current);
        Desk e = d;
        e.swapIn(6);
        d.spare[1] = issue(7);
        {
            Ticket inner = issue(8);
            punch(inner);
        }
        for (int i = 0; i < 2; i += 1) { Ticket loop = new Ticket(20 + i); punch(loop); }
        System.stdout.print(t.id + u.id + x + d.current.id);
        System.stdout.println();
        return 0;
    }
}
