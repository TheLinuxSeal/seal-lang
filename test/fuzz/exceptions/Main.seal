// Fuzz input: exceptions through frames holding uniques and handles; finally on every exit.
import seal.util.List;

struct Main
{
    static int depth(int n)
    {
        Res r = new Res(n);
        Box b = new Box(n);
        if (n == 0) { throw new BadInput("bottom", 42); }
        return depth(n - 1);
    }

    static int withFinally(int x)
    {
        try {
            if (x > 0) { return x; }
            throw new IllegalStateException("x is " + x);
        } finally {
            System.stdout.print("[finally " + x + "] ");
        }
    }

    static int main()
    {
        try {
            depth(2);
        } catch (BadInput e) {
            System.stdout.println();
            System.stdout.println("caught " + e.getMessage() + " code " + e.code);
        }
        try {
            List<int> xs = new List();
            xs.get(3);
        } catch (IndexOutOfBoundsException e) {
            System.stdout.println(e.getMessage());
        }
        System.stdout.println(withFinally(5));
        try {
            withFinally(-1);
        } catch (RuntimeException e) {
            System.stdout.println("runtime: " + e.getMessage());
        }
        for (int i = 0; i < 4; i += 1) {
            try {
                if (i == 1) { continue; }
                if (i == 3) { break; }
                System.stdout.print("body" + i + " ");
            } finally {
                System.stdout.print("fin" + i + " ");
            }
        }
        System.stdout.println();
        try {
            try {
                Integer.parse("zz");
            } catch (IllegalStateException e) {
                System.stdout.println("wrong catch");
            } finally {
                System.stdout.print("inner-finally ");
            }
        } catch (NumberFormatException e) {
            System.stdout.println("outer caught: " + e.getMessage());
        }
        try {
            throw new Exception("plain");
        } catch (Exception e) {
            try {
                throw new RuntimeException("from catch");
            } catch (RuntimeException e2) {
                System.stdout.println(e.getMessage() + " / " + e2.getMessage());
            }
        }
        System.stdout.println(Color.valueOf("GREEN").name());
        try {
            Color.valueOf("PINK");
        } catch (IllegalArgumentException e) {
            System.stdout.println(e.getMessage());
        }
        return 0;
    }
}
