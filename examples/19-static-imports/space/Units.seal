package space;

/** Physical constants, in SI units. */
class Units
{
    public const double G = 6.674e-11;              // the gravitational constant
    public const double EARTH_MASS = 5.972e24;       // kg
    public const double EARTH_RADIUS = 6.371e6;      // m
    public const double GRAVITY = 9.81;              // at the surface, m/s^2
    public const int KM = 1000;
}
