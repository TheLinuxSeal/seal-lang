import macro.*;

// Walks a square: a second forward, then a quarter turn right, four times.
class Square extends(Macro) {
    public void run() {
        look(Math.round(yaw() / 90) * 90, 0); // straight along the blocks
        for (int side = 0; side < 4; side++) {
            hold(Key.FORWARD, 20);
            turn(90, 0);
            waitTicks(5);
        }
    }
}
