// Java's own classes (docs/JAVA.md), imported and used as Seal's are: checked while
// compiling, and called as the JVM calls them. Seal's values go into Java by seal.java's
// classes, JavaInt.of(5) and JavaString.of("Ada"), and come out by casts, (int)x and
// (string)s. It runs on the JVM, Seal's backend; the deprecated VM (--vm) has no Java.
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.LocalDate;
import java.time.temporal.ChronoUnit;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Iterator;
import java.util.List;
import java.util.Random;
import java.util.TreeMap;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import seal.java.*;

class Main
{
    // A class, so its objects are JVM objects Java can hold; a struct or record has no Java form.
    class Tag
    {
        public string name;
        public new(string name) { this.name = name; }
    }

    static void main()
    {
        System.stdout.println("== a java.util.TreeMap keeps its keys sorted ==");
        TreeMap ages = new TreeMap();
        ages.put(JavaString.of("Grace"), JavaIntBoxed.of(85));     // Java's maps hold objects: an Integer
        ages.put(JavaString.of("Ada"), JavaIntBoxed.of(36));
        ages.put(JavaString.of("Linus"), JavaIntBoxed.of(56));
        System.stdout.println(ages);                                // a Java object's text is its toString()
        int ada = (int)ages.get(JavaString.of("Ada"));              // an Integer, unboxed by the cast
        System.stdout.println("first " + ages.firstKey() + ", Ada is " + ada + ", Bob is " + ages.get(JavaString.of("Bob")));

        System.stdout.println("== iterating a Java list ==");
        List colors = List.of(JavaString.of("red"), JavaString.of("green"), JavaString.of("blue"));   // List.of(E...): varargs
        Iterator it = colors.iterator();
        while ((bit)it.hasNext()) {                                 // Java's boolean is a bit by a cast
            string color = (string)it.next();
            System.stdout.print(color.toUpper() + " ");
        }
        System.stdout.println((int)colors.size() + " colors");

        System.stdout.println("== java.time ==");
        LocalDate start = LocalDate.of(JavaInt.of(2026), JavaInt.of(1), JavaInt.of(1));
        LocalDate end = start.plusDays(JavaLong.of(291));
        System.stdout.println(start + " to " + end + ": " + (int<<64>>)ChronoUnit.DAYS.between(start, end) + " days, a "
                + end.getDayOfWeek());

        System.stdout.println("== overloads, chosen as Java chooses them ==");
        System.stdout.println(JavaString.valueOf(JavaChar.of('A')) + " " + JavaString.valueOf(JavaInt.of(65)) + " "
                + JavaString.format(JavaString.of("[%-5s|%6.2f]"), JavaString.of("pi"), JavaDoubleBoxed.of(3.14159)));
        ArrayList numbers = new ArrayList();
        for (int n = 10; n <= 40; n += 10) {
            numbers.add(JavaIntBoxed.of(n));
        }
        numbers.remove(JavaInt.of(0));                              // a JavaInt is Java's int: remove(int index)
        numbers.remove(JavaIntBoxed.of(30));                        // a box is an object: remove(Object)
        System.stdout.println(numbers);

        System.stdout.println("== a seeded java.util.Random gives what Java's gives ==");
        Random random = new Random(JavaLong.of(42));
        for (int i = 0; i < 5; i++) {
            System.stdout.print((int)random.nextInt(JavaInt.of(100)) + " ");
        }
        System.stdout.println();

        System.stdout.println("== a Seal object in a Java collection ==");
        Tag tag = new Tag("Ada");
        ArrayList tags = new ArrayList();
        tags.add(JavaObject.of(tag));                               // a Seal object goes in as Java's Object
        Tag back = (Tag)tags.get(JavaInt.of(0));                    // and comes back by a cast, checked
        System.stdout.println(back.name + " " + (back == tag) + " " + (bit)tags.contains(JavaObject.of(tag)));

        System.stdout.println("== Java's exceptions, caught by their class ==");
        try {
            Files.readString(Path.of(JavaString.of("no-such-file.txt")));
        } catch (IOException e) {
            System.stdout.println(e.getClass().getSimpleName() + ": " + e.getMessage());
        }

        System.stdout.println("== arrays, copied in and out ==");
        array<uint<<8>>> bytes = (array<uint<<8>>>)JavaString.of("Seal ✓").getBytes(JavaString.of("UTF-8"));
        System.stdout.println(bytes.length() + " bytes, the last " + bytes[bytes.length() - 1]);
        JavaArray<JavaString> fruits = JavaString.of("pear,apple,fig").split(JavaString.of(","));
        Arrays.sort(fruits);                                        // Java sorts its own array
        array<string> sorted = (array<string>)fruits;
        Matcher m = Pattern.compile(JavaString.of("[a-z]+")).matcher(JavaString.of("one, two; three"));
        string words = "";
        while ((bit)m.find()) {
            words += (string)m.group() + " ";
        }
        System.stdout.println(sorted[0] + " " + sorted[1] + " " + sorted[2] + " | " + words);
    }
}
