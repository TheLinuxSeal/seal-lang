// Java's own classes (docs/JAVA.md), imported and used as Seal's are: checked while
// compiling, and called as the JVM calls them, generics and all; and Seal's lambdas and
// classes handed to Java as its interfaces, or extending its classes. Seal's values go into Java by seal.java's classes,
// JavaInt.of(5) and JavaString.of("Ada"), and come out by casts, (int)x and (string)s. It runs
// on the JVM, Seal's backend; the deprecated VM (--vm) has no Java.
import java.io.BufferedReader;
import java.io.IOException;
import java.io.StringReader;
import java.lang.Thread;
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.LocalDate;
import java.time.temporal.ChronoUnit;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Random;
import java.util.TreeMap;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import seal.java.*;

class Main {
    // A class, so its objects are JVM objects Java can hold; a struct or record has no Java form.
    class Tag {
        public string name;
        public new(string name) { this.name = name; }
    }

    // A Seal class extending Java's ArrayList: Java's own methods, and the add it overrides, which
    // Java's code calls too.
    class Shouting extends(ArrayList<JavaString>) {
        public JavaBoolean add(JavaString s) { return super.add(s.toUpperCase()); }
    }

    // Java's HashSet finds it by its ==, hashed by its hash(), and prints it by its cast to string.
    class Point {
        public int x;
        public int y;
        public new(int x, int y) { this.x = x; this.y = y; }
        @overload(Operator.EQUALS) public bit same(Point o) { return x == o.x && y == o.y; }
        public uint<<64>> hash() { return (uint<<64>>)(x * 31 + y); }
        @overload(Operator.CAST) public string text() { return "(" + x + ", " + y + ")"; }
    }

    static void main() {
        System.stdout.println("== a java.util.TreeMap keeps its keys sorted ==");
        TreeMap<JavaString, JavaIntBoxed> ages = new TreeMap();    // Java's maps hold objects: an Integer
        ages.put(JavaString.of("Grace"), JavaIntBoxed.of(85));
        ages.put(JavaString.of("Ada"), JavaIntBoxed.of(36));
        ages.put(JavaString.of("Linus"), JavaIntBoxed.of(56));
        System.stdout.println(ages);                                // a Java object's text is its toString()
        int ada = (int)ages.get(JavaString.of("Ada"));              // an Integer, unboxed by the cast
        JavaString first = ages.firstKey();                         // the type argument's type: a JavaString
        System.stdout.println("first " + first + " (" + first.length() + " letters), Ada is " + ada + ", Bob is "
                + ages.get(JavaString.of("Bob")));
        for (Map.Entry<JavaString, JavaIntBoxed> e : ages.entrySet()) {
            System.stdout.print(e.getKey().charAt(JavaInt.of(0)) + "=" + (int)e.getValue() + " ");
        }
        System.stdout.println();

        System.stdout.println("== a Java list, its type arguments worked out ==");
        List<JavaString> colors = List.of(JavaString.of("red"), JavaString.of("green"), JavaString.of("blue"));   // varargs
        for (JavaString color : colors) {
            string c = (string)color;
            System.stdout.print(c.toUpper() + " ");
        }
        ArrayList<JavaString> sorted = new ArrayList(colors);
        Collections.sort(sorted);
        System.stdout.println(sorted + ", " + (int)colors.size() + " colors");

        System.stdout.println("== Java's numbers, with Java's operators ==");
        JavaInt a = JavaInt.of(7);
        JavaLong b = JavaLong.of(5000000000);
        JavaByte small = JavaByte.of(100);
        small += JavaByte.of(100);                                  // a byte wraps, as Java's does
        System.stdout.println((a + b) + " " + (a / JavaInt.of(2)) + " " + small + " " + (bit)(a < JavaInt.of(10)));

        System.stdout.println("== java.time ==");
        LocalDate start = LocalDate.of(JavaInt.of(2026), JavaInt.of(1), JavaInt.of(1));
        LocalDate end = start.plusDays(JavaLong.of(291));
        System.stdout.println(start + " to " + end + ": " + (int<<64>>)ChronoUnit.DAYS.between(start, end) + " days, a "
                + end.getDayOfWeek());

        System.stdout.println("== overloads, chosen as Java chooses them ==");
        System.stdout.println(JavaString.valueOf(JavaChar.of('A')) + " " + JavaString.valueOf(JavaInt.of(65)) + " "
                + JavaString.format(JavaString.of("[%-5s|%6.2f]"), JavaString.of("pi"), JavaDoubleBoxed.of(3.14159)));
        ArrayList<JavaIntBoxed> numbers = new ArrayList();
        for (int n = 10; n <= 40; n += 10) {
            numbers.add(JavaIntBoxed.of(n));
        }
        numbers.remove(JavaInt.of(0));                              // a JavaInt is Java's int: remove(int index)
        numbers.remove(JavaIntBoxed.of(30));                        // a box is an object: remove(Object)
        System.stdout.println(numbers);

        System.stdout.println("== a seeded java.util.Random gives what Java's gives ==");
        Random random = new Random(JavaLong.of(42));
        for (int i = 0; i < 5; i++) {
            System.stdout.print((int)random.nextInt(JavaInt.of(100)) + " ");
        }
        System.stdout.println();

        System.stdout.println("== Seal objects in a Java collection ==");
        Tag tag = new Tag("Ada");
        ArrayList<Tag> tags = new ArrayList();                      // a Seal class as the type argument
        tags.add(tag);
        Tag back = tags.get(JavaInt.of(0));
        ArrayList<JavaObject> things = new ArrayList();
        things.add(JavaObject.of(tag));                             // where Java wants an Object, by JavaObject.of
        System.stdout.println(back.name + " " + (back == tag) + " " + ((Tag)things.get(JavaInt.of(0))).name + " "
                + (bit)things.contains(JavaObject.of(tag)));

        System.stdout.println("== Seal code handed to Java ==");
        Thread worker = new Thread(() -> System.stdout.println("a Java thread runs a Seal lambda"));   // a Runnable
        worker.start();
        worker.join();
        ArrayList<JavaString> people = new ArrayList(List.of(JavaString.of("Linus"), JavaString.of("Ada"), JavaString.of("Grace")));
        people.sort((x, y) -> x.length() - y.length());           // a Comparator, with Java's operators
        List<JavaString> shouting = people.stream().map(s -> s.toUpperCase()).toList();
        HashSet<Point> points = new HashSet();
        points.add(new Point(1, 2));
        points.add(new Point(1, 2));                                // the same point: Java asks Seal's ==
        System.stdout.println(people + " " + shouting + " " + points);
        Shouting loud = new Shouting();
        loud.add(JavaString.of("hello"));
        Collections.addAll(loud, JavaString.of("from"), JavaString.of("java"));   // Java's code, calling Seal's add
        System.stdout.println(loud + " " + loud.reversed() + " " + (int)loud.size());

        System.stdout.println("== Java's exceptions, caught by their class ==");
        try {
            Files.readString(Path.of(JavaString.of("no-such-file.txt")));
        } catch (IOException e) {
            System.stdout.println(e.getClass().getSimpleName() + ": " + e.getMessage());
        }
        try (BufferedReader r = new BufferedReader(new StringReader(JavaString.of("line one\nline two")))) {
            System.stdout.println(r.readLine() + " / " + r.readLine());   // closed after, as Java's try closes it
        }

        System.stdout.println("== arrays, Java's own and copies ==");
        array<uint<<8>>> bytes = (array<uint<<8>>>)JavaString.of("Seal ✓").getBytes(JavaString.of("UTF-8"));
        System.stdout.println(bytes.length() + " bytes, the last " + bytes[bytes.length() - 1]);
        JavaArray<JavaString> fruits = JavaString.of("pear,apple,fig").split(JavaString.of(","));
        Arrays.sort(fruits);                                        // Java sorts its own array
        fruits[0] = fruits[0].toUpperCase();                        // an element, in place
        for (JavaString f : fruits) {
            System.stdout.print(f + " ");
        }
        Matcher m = Pattern.compile(JavaString.of("[a-z]+")).matcher(JavaString.of("one, two; three"));
        string words = "";
        while ((bit)m.find()) {
            words += (string)m.group() + " ";
        }
        System.stdout.println("| " + fruits.length + " fruits | " + words);
    }
}
