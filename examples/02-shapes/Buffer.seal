// The bare shape <<>> (§9.1): Buffer with no values holds 4 slots;
// Buffer<<N>> holds N. Members guarded with <<>> exist only in the bare shape.
struct Buffer<<>>
struct Buffer<<int N>> {
    array<int><<N>> slots<<int N>>;
    array<int><<4>> slots<<>>;

    public int capacity<<int N>>() { return N; }
    public int capacity<<>>() { return 4; }

    public void fill(int v) {
        for (int i = 0; i < capacity(); i++) { slots[i] = v; }
    }

    public int total() {
        int t = 0;
        for (int i = 0; i < capacity(); i++) { t += slots[i]; }
        return t;
    }
}
