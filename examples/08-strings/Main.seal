// Strings (§39): string<<N>> holds up to N characters inline; the bare
// string holds any number, on the heap. Strings are immutable, as in Java:
// methods such as toUpper return a new string, s += x stores a new string in
// s, and a StringBuilder builds text a piece at a time.
import seal.util.List;

struct Main
{
    /** A string<<int N>> parameter accepts a fixed string of any capacity, and N is reused in the result. */
    static string<<N>> shout(string<<int N>> s) { return s.toUpper(); }

    /** ROT13: the new text is built with a StringBuilder, since a string never changes. */
    static string rot13(string s)
    {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            // Arithmetic on a char gives an int, so the result is cast back to a char.
            if (Char.isLower(c)) {
                c = (char)((c - 'a' + 13) % 26 + 'a');
            } else if (Char.isUpper(c)) {
                c = (char)((c - 'A' + 13) % 26 + 'A');
            }
            out.append(c);
        }
        return out.toString();
    }

    static int main()
    {
        System.stdout.println("== fixed-capacity strings ==");
        string<<5>> hello = "Hello";
        string<<7>> world = ", world";
        string<<12>> both = hello + world;     // the capacity is computed: 5 + 7
        System.stdout.println(both);
        System.stdout.print("length ");
        System.stdout.print(both.length());
        System.stdout.print(" of at most ");
        System.stdout.println(both.maxLength());

        System.stdout.println("== bare strings ==");
        string built = "counting:";
        for (int i = 1; i <= 5; i++) {
            built += ' ';          // a new string, stored in built
            built += i * i;
        }
        System.stdout.println(built);
        string upper = built.toUpper();   // a new string: built stays as it is
        System.stdout.println(upper);
        System.stdout.println(built.substring(0, 8));

        System.stdout.println("== building text ==");
        StringBuilder letters = new StringBuilder();
        for (char c = 'a'; c <= 'e'; c++) {
            letters.append(c).append(c);   // append returns the builder, so calls chain
        }
        System.stdout.println(letters.toString());
        letters.reverse();
        letters.setCharAt(0, 'E');
        System.stdout.println(letters + ", " + letters.length() + " characters");

        System.stdout.println("== comparing and sorting ==");
        List<string<<10>>> fruit = new List();
        fruit.add("pear");
        fruit.add("apple");
        fruit.add("fig");
        fruit.add("kiwi");
        fruit.add("banana");
        fruit.sort();
        for (int i = 0; i < fruit.size(); i++) {
            System.stdout.print(fruit.get(i));
            System.stdout.print(" ");
        }
        System.stdout.println();
        string<<10>> apple = "apple";
        System.stdout.print("index of apple: ");
        System.stdout.println(fruit.indexOf(apple));

        System.stdout.println("== characters and numbers ==");
        string<<24>> secret = "Attack at Dawn";
        System.stdout.println(shout(secret));
        string coded = rot13(secret);
        System.stdout.println(coded);
        System.stdout.println(rot13(coded));
        System.stdout.print("\"-12345\" parses to ");
        System.stdout.println(Integer.parse("-12345"));
        System.stdout.print("255 in base 2: ");
        string binary = Integer.toString(255, 2);
        System.stdout.println(binary);
        return 0;
    }
}
