// The memory model (§2.1, §16.1, §26.1): the same operations on a struct,
// a unique and a class, then strings and lists. No pointers anywhere.
import seal.util.List;

struct Main
{
    static void bumpCopy(Counter c) { c.bump(); }        // gets its own copy
    static void punch(Ticket t) { t.id += 100; }         // lent: changes the caller's ticket
    static Ticket issue(int id)
    {
        Ticket t = new Ticket(id);
        return t;                                        // moved out to the caller, not closed
    }
    static void bumpNote(Note n) { n.n++; }           // the same object as the caller's

    static int main()
    {
        System.stdout.println("== struct: a value that is copied ==");
        Counter a;
        a.n = 1;
        Counter b = a;               // b is a copy
        b.bump();
        bumpCopy(a);                 // bumps a copy; a is unchanged
        System.stdout.print("a.n = ");
        System.stdout.print(a.n);
        System.stdout.print(", b.n = ");
        System.stdout.println(b.n);
        a.bump();                    // a method changes a itself
        System.stdout.print("after a.bump(), a.n = ");
        System.stdout.println(a.n);

        System.stdout.println("== unique: a value that can't be copied ==");
        {
            Ticket t = new Ticket(1);
            punch(t);                // lent, so punch changes t itself
            System.stdout.print("  after punch(t), t.id = ");
            System.stdout.println(t.id);
            // Ticket copy = t;      would not compile: Ticket is unique
            t = new Ticket(2);       // the old ticket is closed first
            Ticket u = issue(3);     // returned by moving
            System.stdout.println("  end of block");
        }                            // destroyed in reverse order: u, then t

        System.stdout.println("== class: a shared object ==");
        Note x = new Note(10);
        Note y = x;                  // the same note
        bumpNote(y);
        System.stdout.println("  x.n = " + x.n + ", the same note as y: " + (x == y));
        x = null;
        System.stdout.println("  x = null: y still refers to the note, n = " + y.n);
        y = null;                    // nothing refers to the note now, so it is freed

        System.stdout.println("== string: a value that never changes ==");
        string greeting = "hello";
        string copy = greeting;      // the same characters, which neither can change
        copy += ", world";           // a new string in copy; greeting still holds hello
        System.stdout.print("  greeting = ");
        System.stdout.print(greeting);
        System.stdout.print(", copy = ");
        System.stdout.println(copy);

        System.stdout.println("== List: a shared object ==");
        List<int> first = new List();
        List<int> second = first;    // the same list
        second.add(5);
        second.add(6);
        System.stdout.print("  first.size() = ");
        System.stdout.println(first.size());
        return 0;
    }
}
