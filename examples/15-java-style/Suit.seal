// An enum with a field and a method; switch can name its constants bare.
enum Suit {
    CLUBS('c'),
    DIAMONDS('d'),
    HEARTS('h'),
    SPADES('s');

    char letter;

    new(char l) { letter = l; }

    public bit isRed() {
        switch (ordinal()) {
            case 1, 2 -> { return true; }
            default -> { return false; }
        }
    }

    public char symbol() { return letter; }
}
