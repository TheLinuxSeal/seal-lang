package shop.stock;

/** How many of a product are on the shelf: an Item too, but not the one in shop.model. */
class Item
{
    public string product;
    public int onShelf;

    public new(string product, int onShelf) { this.product = product; this.onShelf = onShelf; }

    public bit isLow() { return onShelf < 5; }
}
