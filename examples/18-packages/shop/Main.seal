// Packages and imports (§2.4): each file says its package, which is also its
// folder (shop/model/Item.seal is in package shop.model), and imports what it
// uses from other packages. So does the standard library's: seal.lang (System,
// Math, the exceptions) needs no import, as Java's java.lang, but seal.util does.
package shop;

import seal.util.List;          // the standard library's, outside seal.lang
import shop.model.*;            // every type of shop.model
import shop.pricing.Discount;   // single types, by name
import shop.pricing.PercentOff;
import shop.pricing.BulkDeal;
import shop.report.Receipt;
import shop.stock.Item as StockItem;            // a second Item, under another name
import static shop.pricing.Money.text as dollars; // a static method, renamed too

class Main
{
    static void main()
    {
        Item notebook = new Item("Notebook", Category.PAPER, 3.50);
        Item pen = new Item("Pen", Category.PENS, 1.20);
        Item novel = new Item("Novel", Category.BOOKS, 14.99);

        Cart cart = new Cart();
        cart.add(notebook, 4);
        cart.add(pen, 7);
        cart.add(novel, 1);

        List<Discount> deals = new List();
        deals.add(new PercentOff(Category.PAPER, 10));
        deals.add(new BulkDeal("Pen", 3));

        new Receipt(cart, deals).print();

        // Any type can be named in full instead of imported: Money isn't imported here.
        System.stdout.println("A thousand notebooks: " + shop.pricing.Money.text(1000 * notebook.price));

        // Two types named Item: Item is shop.model's, from the * import, and StockItem is
        // shop.stock's. `as` gives a type, or a static member, the name this file knows it by.
        List<StockItem> stock = new List();
        stock.add(new StockItem("Notebook", 12));
        stock.add(new StockItem("Pen", 3));
        for (StockItem s : stock) {
            if (s.isLow()) { System.stdout.println("Low on " + s.product + ": " + s.onShelf + " left"); }
        }
        System.stdout.println("The pens left are worth " + dollars(3 * pen.price));
    }
}
