{
  "name": "seal",
  "displayName": "Seal",
  "description": "The Seal programming language: highlighting, and seal lsp's errors, hover, go to definition and outline",
  "version": "0.1.0",
  "publisher": "thelinuxseal",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheLinuxSeal/seal-lang"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:seal"],
  "contributes": {
    "configuration": {
      "title": "Seal",
      "properties": {
        "seal.path": {
          "type": "string",
          "default": "seal",
          "description": "The seal command, which the language server is started with as seal lsp: a path, or a name on PATH."
        },
        "seal.serverArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Options for seal lsp, as for seal check: --classpath PATH, --stdlib DIR, -Wall, -Wvar..."
        }
      }
    },
    "commands": [
      { "command": "seal.restartServer", "title": "Seal: Restart the Language Server" }
    ],
    "languages": [
      {
        "id": "seal",
        "aliases": ["Seal", "seal"],
        "extensions": [".seal"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "seal",
        "scopeName": "source.seal",
        "path": "./syntaxes/seal.tmLanguage.json"
      }
    ]
  }
}
