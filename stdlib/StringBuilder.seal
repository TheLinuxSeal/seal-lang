// Text built a piece at a time, as Java's StringBuilder. Strings are
// immutable, so each `s += x` makes a new string; a StringBuilder adds to
// itself instead, and toString(), or a cast to string, gives the text:
//
//   StringBuilder b = new StringBuilder();
//   for (int i = 0; i < n; i++) { b.append(i).append(' '); }
//   string s = b.toString();
//
// append takes everything print does (strings, characters, numbers, bits, and
// any value that casts to string) and returns the builder, so calls chain.
class StringBuilder
{
    array<char> chars;   // the first count are the text; the rest is room to grow
    int count;

    public new() { }

    /** An empty builder with room for capacity characters. */
    public new(int capacity) { reserve(capacity); }

    /** A builder starting with this text. */
    public new(string text) { append(text); }

    /** A builder starting with this character. (In Java, new StringBuilder('a') would set the capacity to 97.) */
    public new(char c) { append(c); }

    public int length() { return count; }

    public bit isEmpty() { return count == 0; }

    public char charAt(int i)
    {
        check(i);
        return chars[i];
    }

    public void setCharAt(int i, char c)
    {
        check(i);
        chars[i] = c;
    }

    /** Cuts the text to n characters, or pads it with '\0' up to n. */
    public void setLength(int n)
    {
        if (n < 0) { throw new IndexOutOfBoundsException("length " + n + " is negative"); }
        reserve(n);
        for (int i = count; i < n; i++) { chars[i] = '\0'; }
        count = n;
    }

    // ------------------------------------------------------------ appending

    public StringBuilder append(char c)
    {
        reserve(count + 1);
        chars[count] = c;
        count++;
        return this;
    }

    public StringBuilder append(string text)
    {
        int n = text.length();
        reserve(count + n);
        for (int i = 0; i < n; i++) { chars[count + i] = text.charAt(i); }
        count += n;
        return this;
    }

    public StringBuilder append(string<<int K>> text)
    {
        int n = text.length();
        reserve(count + n);
        for (int i = 0; i < n; i++) { chars[count + i] = text.charAt(i); }
        count += n;
        return this;
    }

    public StringBuilder append(int x) { return append(Integer.toString(x)); }
    public StringBuilder append(int<<int W>> x) { return append(Integer.toString((int<<64>>)x)); }
    public StringBuilder append(uint<<int W>> x) { return append(Integer.toString((uint<<64>>)x)); }
    public StringBuilder append(double x) { return append(Double.toString(x)); }
    public StringBuilder append(float x) { return append(Float.toString(x)); }
    public StringBuilder append(fixed<<int A, int B>> x) { return append(Fixed.toString(x)); }
    public StringBuilder append(ufixed<<int A, int B>> x) { return append(Fixed.toString(x)); }
    public StringBuilder append(bit x) { return append(x ? "true" : "false"); }

    /** Any other value, as its type's cast to string makes it (§46). */
    public <T> StringBuilder append(T x) { return append((string)x); }

    // ------------------------------------------------------------ editing

    /** Puts text before the character at i (0 to length()). */
    public StringBuilder insert(int i, string text)
    {
        if (i < 0 || i > count) { throw new IndexOutOfBoundsException("insert index " + i + " out of range for length " + count); }
        int n = text.length();
        reserve(count + n);
        for (int j = count - 1; j >= i; j--) { chars[j + n] = chars[j]; }
        for (int j = 0; j < n; j++) { chars[i + j] = text.charAt(j); }
        count += n;
        return this;
    }

    public StringBuilder insert(int i, char c)
    {
        string one;
        one += c;
        return insert(i, one);
    }

    /** Removes the characters from (inclusive) to to (exclusive; past the end means to the end). */
    public StringBuilder delete(int from, int to)
    {
        if (to > count) { to = count; }
        if (from < 0 || from > to) { throw new IndexOutOfBoundsException("delete(" + from + ", " + to + ") out of range for length " + count); }
        int n = to - from;
        for (int j = to; j < count; j++) { chars[j - n] = chars[j]; }
        count -= n;
        return this;
    }

    public StringBuilder deleteCharAt(int i)
    {
        check(i);
        return this.delete(i, i + 1);
    }

    public StringBuilder reverse()
    {
        int i = 0;
        int j = count - 1;
        while (i < j) {
            chars.swap(i, j);
            i++;
            j--;
        }
        return this;
    }

    /** Index of the first place `part` starts, or -1. */
    public int indexOf(string part) { return toString().indexOf(part); }

    /** The text so far, as a new string; the builder can go on. */
    @overload(Operator.CAST)
    public string toString() { return new string(chars, 0, count); }

    /** Makes room for at least n characters. */
    void reserve(int n)
    {
        if (n <= chars.length()) { return; }
        int c = chars.length() * 2;
        if (c < 16) { c = 16; }
        if (c < n) { c = n; }
        chars = chars.copyOf(c);
    }

    void check(int i)
    {
        if (i < 0 || i >= count) { throw new IndexOutOfBoundsException("index " + i + " out of range for length " + count); }
    }
}
