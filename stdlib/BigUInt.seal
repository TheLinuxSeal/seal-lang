// Unsigned integers of any fixed width (the example from §54), stored as
// 64-bit words, least significant first. Arithmetic wraps at BITS bits.
struct BigUInt<<int BITS>>
{
    array<uint<<64>>><<(BITS + 63) / 64>> words;

    /** Sets the value to v. */
    public void set(uint<<64>> v)
    {
        clear();
        words[0] = v;
        trim();
    }

    public void clear()
    {
        for (int i = 0; i < (BITS + 63) / 64; i++) { words[i] = 0; }
    }

    /** The low 64 bits. */
    public uint<<64>> low() { return words[0]; }

    public bit isZero()
    {
        for (int i = 0; i < (BITS + 63) / 64; i++) {
            if (words[i] != 0) { return false; }
        }
        return true;
    }

    // ------------------------------------------------------------ arithmetic

    @overload(Operator.ADD)
    public BigUInt<<BITS>> add(BigUInt<<BITS>> o)
    {
        BigUInt<<BITS>> r;
        uint<<64>> carry = 0;
        for (int i = 0; i < (BITS + 63) / 64; i++) {
            uint<<64>> s = words[i] + o.words[i];
            uint<<64>> c = 0;
            if (s < words[i]) { c = 1; }
            uint<<64>> t = s + carry;
            if (t < s) { c = 1; }
            r.words[i] = t;
            carry = c;
        }
        r.trim();
        return r;
    }

    @overload(Operator.SUBTRACT)
    public BigUInt<<BITS>> sub(BigUInt<<BITS>> o)
    {
        BigUInt<<BITS>> r;
        uint<<64>> borrow = 0;
        for (int i = 0; i < (BITS + 63) / 64; i++) {
            uint<<64>> d = words[i] - o.words[i];
            uint<<64>> b = 0;
            if (words[i] < o.words[i]) { b = 1; }
            uint<<64>> t = d - borrow;
            if (d < borrow) { b = 1; }
            r.words[i] = t;
            borrow = b;
        }
        r.trim();
        return r;
    }

    @overload(Operator.MULTIPLY)
    public BigUInt<<BITS>> mul(BigUInt<<BITS>> o)
    {
        BigUInt<<BITS>> r;
        int n = (BITS + 63) / 64;
        for (int i = 0; i < n; i++) {
            uint<<64>> carry = 0;
            for (int j = 0; i + j < n; j++) {
                uint<<64>> lo = words[i] * o.words[j];
                uint<<64>> hi = mulHigh(words[i], o.words[j]);
                uint<<64>> t = r.words[i + j] + lo;
                uint<<64>> c = 0;
                if (t < lo) { c = 1; }
                uint<<64>> t2 = t + carry;
                if (t2 < t) { c++; }
                r.words[i + j] = t2;
                carry = hi + c;
            }
        }
        r.trim();
        return r;
    }

    /** Divides in place by a small divisor; returns the remainder. */
    public uint<<32>> divSmall(uint<<32>> d)
    {
        if (d == 0) { throw new ArithmeticException("BigUInt division by zero"); }
        uint<<64>> divisor = (uint<<64>>)d;
        uint<<64>> rem = 0;
        for (int i = (BITS + 63) / 64 - 1; i >= 0; i--) {
            uint<<64>> w = words[i];
            uint<<64>> hi = (rem <<< 32) | (w <<< -32);
            uint<<64>> qhi = hi / divisor;
            rem = hi % divisor;
            uint<<64>> lo = (rem <<< 32) | (w & 4294967295);
            uint<<64>> qlo = lo / divisor;
            rem = lo % divisor;
            words[i] = (qhi <<< 32) | qlo;
        }
        return (uint<<32>>)rem;
    }

    /** Multiplies in place by a small factor and adds a small value. */
    public void mulAddSmall(uint<<32>> m, uint<<32>> a)
    {
        uint<<64>> carry = (uint<<64>>)a;
        for (int i = 0; i < (BITS + 63) / 64; i++) {
            uint<<64>> lo = words[i] * (uint<<64>>)m;
            uint<<64>> hi = mulHigh(words[i], (uint<<64>>)m);
            uint<<64>> t = lo + carry;
            if (t < lo) { hi++; }
            words[i] = t;
            carry = hi;
        }
        trim();
    }

    // ------------------------------------------------------------ comparison

    @overload(Operator.EQUALS)
    public bit same(BigUInt<<BITS>> o)
    {
        for (int i = 0; i < (BITS + 63) / 64; i++) {
            if (words[i] != o.words[i]) { return false; }
        }
        return true;
    }

    @overload(Operator.LESS)
    public bit isLess(BigUInt<<BITS>> o)
    {
        for (int i = (BITS + 63) / 64 - 1; i >= 0; i--) {
            if (words[i] != o.words[i]) { return words[i] < o.words[i]; }
        }
        return false;
    }

    // ------------------------------------------------------------ shifts (§49)

    /** Shifted left by n bits, or right for negative n. */
    @overload(Operator.SHIFT)
    public BigUInt<<BITS>> shifted(int n)
    {
        BigUInt<<BITS>> r;
        int count = (BITS + 63) / 64;
        if (n >= BITS || -n >= BITS) { return r; }
        int wordShift = n / 64;
        int bitShift = n % 64;
        if (n < 0) {
            wordShift = (-n) / 64;
            bitShift = (-n) % 64;
        }
        for (int i = 0; i < count; i++) {
            uint<<64>> v = 0;
            if (n >= 0) {
                int src = i - wordShift;
                if (src >= 0) { v = words[src] <<< bitShift; }
                if (bitShift > 0 && src - 1 >= 0) { v = v | (words[src - 1] <<< (bitShift - 64)); }
            } else {
                int src = i + wordShift;
                if (src < count) { v = words[src] <<< -bitShift; }
                if (bitShift > 0 && src + 1 < count) { v = v | (words[src + 1] <<< (64 - bitShift)); }
            }
            r.words[i] = v;
        }
        r.trim();
        return r;
    }

    @overload(Operator.SHIFT_ASSIGN)
    public void shiftInPlace(int n)
    {
        BigUInt<<BITS>> r = shifted(n);
        for (int i = 0; i < (BITS + 63) / 64; i++) { words[i] = r.words[i]; }
    }

    // ------------------------------------------------------------ text

    /** The decimal text, for "x = " + big and println(big) (§46). */
    // a += b, a -= b and a *= b change a itself; they are operators of their own (§46).
    @overload(Operator.ADD_ASSIGN) public void addInPlace(BigUInt<<BITS>> o) { words = add(o).words; }
    @overload(Operator.SUBTRACT_ASSIGN) public void subInPlace(BigUInt<<BITS>> o) { words = sub(o).words; }
    @overload(Operator.MULTIPLY_ASSIGN) public void mulInPlace(BigUInt<<BITS>> o) { words = mul(o).words; }

    @overload(Operator.CAST) public string text() { return toString(); }

    /** Decimal text, as a new bare string the caller owns. */
    public string toString()
    {
        array<char><<(BITS * 31) / 100 + 2>> digits;
        int n = 0;
        BigUInt<<BITS>> v;
        for (int i = 0; i < (BITS + 63) / 64; i++) { v.words[i] = words[i]; }
        while (true) {
            digits[n] = (char)(v.divSmall(10) + '0');
            n++;
            if (v.isZero()) { break; }
        }
        StringBuilder s = new StringBuilder(n);
        for (int i = n - 1; i >= 0; i--) { s.append(digits[i]); }
        return s.toString();
    }

    /** Sets the value from decimal text; fails on anything but digits. */
    public void parse(string text)
    {
        clear();
        for (int i = 0; i < text.length(); i++) {
            char c = text.charAt(i);
            if (!Char.isDigit(c)) { throw new NumberFormatException("BigUInt.parse: not a decimal number"); }
            mulAddSmall(10, (uint<<32>>)Char.digitValue(c));
        }
    }

    // ------------------------------------------------------------ helpers

    /** Clears the bits of the top word above BITS, so values wrap at BITS bits. */
    void trim()
    {
        int extra = (BITS + 63) / 64 * 64 - BITS;
        if (extra > 0) {
            int top = (BITS + 63) / 64 - 1;
            uint<<64>> ones = 18446744073709551615;
            words[top] = words[top] & (ones <<< -extra);
        }
    }

    /** The high 64 bits of the 128-bit product a * b. */
    static uint<<64>> mulHigh(uint<<64>> a, uint<<64>> b)
    {
        uint<<64>> a0 = a & 4294967295;
        uint<<64>> a1 = a <<< -32;
        uint<<64>> b0 = b & 4294967295;
        uint<<64>> b1 = b <<< -32;
        uint<<64>> p00 = a0 * b0;
        uint<<64>> p01 = a0 * b1;
        uint<<64>> p10 = a1 * b0;
        uint<<64>> p11 = a1 * b1;
        uint<<64>> mid = (p00 <<< -32) + (p01 & 4294967295) + (p10 & 4294967295);
        return p11 + (p01 <<< -32) + (p10 <<< -32) + (mid <<< -32);
    }
}
