// Integer utilities (§42).
struct Integer
{
    public const int MIN_INT = -2147483648;
    public const int MAX_INT = 2147483647;
    public const int<<64>> MIN_INT64 = -9223372036854775808;
    public const int<<64>> MAX_INT64 = 9223372036854775807;
    public const uint<<64>> MAX_UINT64 = 18446744073709551615;

    // ------------------------------------------------------------ text

    /** Decimal text of x, as a new bare string the caller owns (§43). */
    public static string toString(int<<64>> x)
    {
        string s;
        if (x < 0) {
            s.append(45);
            // Negate as unsigned so that MIN_INT64 works.
            appendDigits(*s, 0 - (uint<<64>>)x);
        } else {
            appendDigits(*s, (uint<<64>>)x);
        }
        return s;
    }

    public static string toString(uint<<64>> x)
    {
        string s;
        appendDigits(*s, x);
        return s;
    }

    public static string toString(int x) { return toString((int<<64>>)x); }
    public static string toString(uint x) { return toString((uint<<64>>)x); }

    /** Text of x in the given base (2 to 36), as a new bare string the caller owns. */
    public static string toString(uint<<64>> x, int base)
    {
        if (base < 2 || base > 36) { throw new IllegalArgumentException("base must be between 2 and 36, not " + base); }
        array<char><<64>> digits;
        int n = 0;
        uint<<64>> b = (uint<<64>>)base;
        while (true) {
            uint<<64>> d = x % b;
            if (d < 10) { digits[n] = (char)(d + '0'); } else { digits[n] = (char)(d - 10 + 'a'); }
            n++;
            x = x / b;
            if (x == 0) { break; }
        }
        string s;
        s.reserve(n);
        for (int i = n - 1; i >= 0; i--) { s.append(digits[i]); }
        return s;
    }

    /** Appends the decimal digits of x. Takes an address: a string passed by value is a shallow copy. */
    static void appendDigits(addr<string> s, uint<<64>> x)
    {
        array<char><<20>> digits;
        int n = 0;
        while (true) {
            digits[n] = (char)(x % 10 + '0');
            n++;
            x = x / 10;
            if (x == 0) { break; }
        }
        (&s).reserve((&s).length() + n);
        for (int i = n - 1; i >= 0; i--) { (&s).append(digits[i]); }
    }

    public static int<<64>> parse(string s) { return s.toInt(); }
    public static int<<64>> parse(string<<int N>> s) { return s.toInt(); }

    // ------------------------------------------------------------ arithmetic

    public static int min(int a, int b) { if (a < b) { return a; } return b; }
    public static int max(int a, int b) { if (a > b) { return a; } return b; }
    public static int<<64>> min(int<<64>> a, int<<64>> b) { if (a < b) { return a; } return b; }
    public static int<<64>> max(int<<64>> a, int<<64>> b) { if (a > b) { return a; } return b; }

    // ------------------------------------------------------------ exact multiplication
    //
    // An N-bit integer times a P-bit integer always fits in N + P bits, so these
    // never overflow: int × int → int<<64>>. Mixed widths need no casts. Results
    // wider than 64 bits are rejected when used; use BigUInt for those.

    public static int<<N + P>> mulExact(int<<int N>> a, int<<int P>> b)
    {
        return (int<<N + P>>)a * (int<<N + P>>)b;
    }

    public static uint<<N + P>> mulExact(uint<<int N>> a, uint<<int P>> b)
    {
        return (uint<<N + P>>)a * (uint<<N + P>>)b;
    }

    /** Signed times unsigned: the unsigned value fits in N + P signed bits, and so does the product. */
    public static int<<N + P>> mulExact(int<<int N>> a, uint<<int P>> b)
    {
        return (int<<N + P>>)a * (int<<N + P>>)b;
    }

    public static int<<N + P>> mulExact(uint<<int N>> a, int<<int P>> b)
    {
        return (int<<N + P>>)a * (int<<N + P>>)b;
    }

    public static int abs(int x) { if (x < 0) { return -x; } return x; }
    public static int<<64>> abs(int<<64>> x) { if (x < 0) { return -x; } return x; }

    public static int sign(int<<64>> x)
    {
        if (x < 0) { return -1; }
        if (x > 0) { return 1; }
        return 0;
    }

    public static int<<64>> gcd(int<<64>> a, int<<64>> b)
    {
        a = abs(a);
        b = abs(b);
        while (b != 0) {
            int<<64>> t = a % b;
            a = b;
            b = t;
        }
        return a;
    }

    /** base raised to a non-negative power, wrapping on overflow. */
    public static int<<64>> pow(int<<64>> base, int exponent)
    {
        if (exponent < 0) { throw new IllegalArgumentException("negative exponent " + exponent); }
        int<<64>> result = 1;
        while (exponent > 0) {
            if (exponent % 2 == 1) { result = result * base; }
            base = base * base;
            exponent = exponent / 2;
        }
        return result;
    }

    // ------------------------------------------------------------ bits (§50)

    /** Rotates left by n bits (n may be negative or larger than 32). */
    public static uint rol(uint x, int n)
    {
        n = (n % 32 + 32) % 32;
        return (x <<< n) | (x <<< (n - 32));
    }

    public static uint ror(uint x, int n) { return rol(x, -n); }

    public static uint<<64>> rol(uint<<64>> x, int n)
    {
        n = (n % 64 + 64) % 64;
        return (x <<< n) | (x <<< (n - 64));
    }

    public static uint<<64>> ror(uint<<64>> x, int n) { return rol(x, -n); }

    /** Number of 1 bits. */
    public static int bitCount(uint<<64>> x)
    {
        int n = 0;
        while (x != 0) {
            x = x & (x - 1);
            n++;
        }
        return n;
    }

    /** Number of 0 bits above the highest 1 bit; 64 for zero. */
    public static int leadingZeros(uint<<64>> x)
    {
        if (x == 0) { return 64; }
        int n = 0;
        while (!x[63]) {
            x = x <<< 1;
            n++;
        }
        return n;
    }

    /** Number of 0 bits below the lowest 1 bit; 64 for zero. */
    public static int trailingZeros(uint<<64>> x)
    {
        if (x == 0) { return 64; }
        int n = 0;
        while (!x[0]) {
            x = x <<< -1;
            n++;
        }
        return n;
    }
}
