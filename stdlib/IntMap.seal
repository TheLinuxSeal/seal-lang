// A hash map from 64-bit integer keys to V (open addressing, linear probing).
// IntMap is a class: create one with `new IntMap()`; it is shared and freed
// automatically.
class IntMap<V>
{
    array<int<<64>>> keyData;
    array<V> valueData;
    // One bit per slot: whether it holds an entry. An array<bit> takes a bit per element.
    array<bit> used;
    int count;
    V blank;   // never assigned; used to clear removed values

    public int size() { return count; }

    public bit isEmpty() { return count == 0; }

    /** Adds or replaces the value for key. */
    public void put(int<<64>> key, V value)
    {
        if ((count + 1) * 4 > capacity() * 3) { grow(); }
        int i = find(key);
        if (!used[i]) {
            used[i] = true;
            keyData[i] = key;
            count++;
        }
        valueData[i] = value;
    }

    public bit has(int<<64>> key)
    {
        if (capacity() == 0) { return false; }
        return used[find(key)];
    }

    /** The value for key; fails if there is none. */
    public V get(int<<64>> key)
    {
        if (!has(key)) { throw new NoSuchElementException("IntMap.get: no key " + key); }
        return valueData[find(key)];
    }

    /** Removes key; returns whether it was present. */
    public bit remove(int<<64>> key)
    {
        if (!has(key)) { return false; }
        int hole = find(key);
        used[hole] = false;
        valueData[hole] = blank;
        count--;
        // Shift later entries of the same probe run back into the hole.
        int j = hole;
        while (true) {
            j = (j + 1) & (capacity() - 1);
            if (!used[j]) { return true; }
            int home = slotOf(keyData[j]);
            bit stays;
            if (hole <= j) { stays = hole < home && home <= j; } else { stays = hole < home || home <= j; }
            if (!stays) {
                keyData[hole] = keyData[j];
                valueData[hole] = valueData[j];
                valueData[j] = blank;
                used[hole] = true;
                used[j] = false;
                hole = j;
            }
        }
    }

    /** All keys, in no particular order. */
    public List<int<<64>>> keys()
    {
        List<int<<64>>> out = new List();
        out.reserve(count);
        for (int i = 0; i < capacity(); i++) {
            if (used[i]) { out.add(keyData[i]); }
        }
        return out;
    }

    public void clear()
    {
        used.fill(false);
        valueData.fill(blank);
        count = 0;
    }

    int capacity() { return used.length(); }

    /** The slot holding key, or the empty slot where it would go. */
    int find(int<<64>> key)
    {
        int i = slotOf(key);
        while (used[i] && keyData[i] != key) { i = (i + 1) & (capacity() - 1); }
        return i;
    }

    int slotOf(int<<64>> key)
    {
        uint<<64>> h = (uint<<64>>)key * 11400714819323198485;
        h = h ^ (h <<< -29);
        return (int)(h & (uint<<64>>)(capacity() - 1));
    }

    void grow()
    {
        int c = capacity() * 2;
        if (c < 16) { c = 16; }
        // The entries, copied out, go back into a table twice as big.
        array<int<<64>>> oldKeys = keyData.copy();
        array<V> oldValues = valueData.copy();
        array<bit> oldUsed = used.copy();
        keyData = new array<int<<64>>>(c);
        valueData = new array<V>(c);
        used = new array<bit>(c);
        count = 0;
        for (int i = 0; i < oldUsed.length(); i++) {
            if (oldUsed[i]) { put(oldKeys[i], oldValues[i]); }
        }
    }
}
