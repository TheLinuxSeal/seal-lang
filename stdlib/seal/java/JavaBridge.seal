package seal.java;

// The way into Java (docs/JAVA.md): Java's classes by name, and new objects of
// them. What a Java object then does, JavaObject's and JavaClass's methods do.
//
//   JavaObject names = JavaBridge.create("java.util.ArrayList");
//   names.invoke("add", [JavaString.of("Ada")]);
//   JavaClass math = JavaBridge.get("java.lang.Math");
//   int bigger = (int)math.invokeStatic("max", [JavaInt.of(3), JavaInt.of(9)]);
//
// A class is named in full, as the JVM names it (java.util.Map$Entry for a
// nested one), and found as the program's own classes are: in the JDK, and in
// the jars `seal run --classpath` names. Only public classes, methods and
// fields are reached. The bridge runs only on the JVM; what goes wrong at it
// (no such class, no method the arguments fit) stops the program, for now.
struct JavaBridge
{
    /** The class so named: "java.util.ArrayList". */
    @jvm("JavaBridge.get") public static JavaClass get(string className);

    /** A new object of the class so named, by its constructor that takes no arguments. */
    @jvm("JavaBridge.createNamed") public static JavaObject create(string className);

    /** A new object of the class so named, by the constructor the arguments choose, as Java chooses. */
    @jvm("JavaBridge.createNamed") public static JavaObject create(string className, array<JavaObject> args);
}
