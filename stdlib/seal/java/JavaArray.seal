package seal.java;

// Java arrays (docs/JAVA.md §3.1), for the Java methods that take or give them:
// byte[] APIs, a typed array for a varargs parameter, a buffer Java fills.
//
//   JavaObject bytes = JavaArray.of(data);                 // array<uint<<8>>> to a new byte[]
//   JavaObject paths = JavaArray.of("java.nio.file.Path", [a, b]);   // a Path[]
//   JavaObject buffer = JavaArray.create("byte", 4096);     // new byte[4096]
//   array<uint<<8>>> back = (array<uint<<8>>>)buffer;      // a cast copies it out
//
// Arrays are copied going in and coming out: a Seal array is a unique, which
// nothing else may hold, so Java gets an array of its own. An array of
// int<<8>> or uint<<8>> is a byte[] (uint<<8>>'s by their bits), and of
// int<<16>> a short[].
struct JavaArray
{
    @jvm("JavaBridge.arrayOfBytes") public static JavaObject of(array<int<<8>>> xs);
    @jvm("JavaBridge.arrayOfBytes") public static JavaObject of(array<uint<<8>>> xs);
    @jvm("JavaBridge.arrayOfShorts") public static JavaObject of(array<int<<16>>> xs);
    @jvm("JavaBridge.arrayOfInts") public static JavaObject of(array<int> xs);
    @jvm("JavaBridge.arrayOfLongs") public static JavaObject of(array<int<<64>>> xs);
    @jvm("JavaBridge.arrayOfFloats") public static JavaObject of(array<float> xs);
    @jvm("JavaBridge.arrayOfDoubles") public static JavaObject of(array<double> xs);
    @jvm("JavaBridge.arrayOfChars") public static JavaObject of(array<char> xs);
    @jvm("JavaBridge.arrayOfBooleans") public static JavaObject of(array<bit> xs);
    @jvm("JavaBridge.arrayOfStrings") public static JavaObject of(array<string> xs);

    /** An Object[] of the elements. */
    @jvm("JavaBridge.arrayOfObjects") public static JavaObject of(array<JavaObject> xs);

    /** An array of the class so named ("java.nio.file.Path", or a primitive: "int"), holding the elements. */
    @jvm("JavaBridge.arrayOfClass") public static JavaObject of(string elementClass, array<JavaObject> xs);

    /** A new array of the class so named, or a primitive ("byte"), of that length, holding Java's defaults. */
    @jvm("JavaBridge.newArray") public static JavaObject create(string elementClass, int length);
}
