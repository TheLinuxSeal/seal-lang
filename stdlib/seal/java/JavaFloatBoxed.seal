package seal.java;

// Java's java.lang.Float (docs/JAVA.md §3.1), with its own methods: an object holding a number,
// for what Java wants an object for, a List's elements or an Object parameter. JavaFloatBoxed.of(x) boxes
// a Seal float, and a cast, (float)b, unboxes one; a null box stops the program there.
class JavaFloatBoxed {
    @jvm("JavaValues.floatBoxed") public static JavaFloatBoxed of(float x);
}
