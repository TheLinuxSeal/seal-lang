package seal.java;

// Java's java.lang.Integer (docs/JAVA.md §3.1), with its own methods: an object holding a number,
// for what Java wants an object for, a List's elements or an Object parameter. JavaIntBoxed.of(x) boxes
// a Seal int, and a cast, (int)b, unboxes one; a null box stops the program there.
class JavaIntBoxed {
    @jvm("JavaValues.intBoxed") public static JavaIntBoxed of(int x);
}
