package seal.java;

// What goes wrong at the Java bridge (docs/JAVA.md §7). Each kind has its own
// subclass, and catching this one catches them all:
//
//   try {
//       JavaBridge.get("org.example.Plugin").invokeStatic("start");
//   } catch (JavaClassNotFoundException e) {
//       System.stdout.println("no plugin");
//   } catch (JavaException e) {
//       System.stdout.println("the plugin failed: " + e.getMessage());
//   }
//
// It is thrown as itself for what fits none of the subclasses: setting a
// final field, an array of a negative length.
class JavaException extends(RuntimeException)
{
    public new(string message) { super(message); }
}
