package seal.java;

// Java's java.lang.Short (docs/JAVA.md §3.1), with its own methods: an object holding a number,
// for what Java wants an object for, a List's elements or an Object parameter. JavaShortBoxed.of(x) boxes
// a Seal int<<16>>, and a cast, (int<<16>>)b, unboxes one; a null box stops the program there.
class JavaShortBoxed
{
    @jvm("JavaValues.shortBoxed") public static JavaShortBoxed of(int<<16>> x);
}
