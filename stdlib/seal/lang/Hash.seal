package seal.lang;

// Hash codes for HashMap keys (§42.4). Numbers, chars, bits and strings hash
// by value; anything else by its own hash() method, which every class has
// (Object's hashes by identity) and a struct can define.
struct Hash
{
    public static uint<<64>> of(int x) { return mix((uint<<64>>)(int<<64>>)x); }
    public static uint<<64>> of(int<<int W>> x) { return mix((uint<<64>>)(int<<64>>)x); }
    public static uint<<64>> of(uint<<int W>> x) { return mix((uint<<64>>)x); }
    public static uint<<64>> of(char c) { return mix((uint<<64>>)c); }
    public static uint<<64>> of(bit b) { return b ? mix(1) : mix(2); }
    public static uint<<64>> of(double x) { return mix(doubleBits(x == 0.0 ? 0.0 : x)); } // 0.0 and -0.0 are ==
    public static uint<<64>> of(float x) { return mix(floatBits(x == 0.0 ? 0.0 : x)); }
    public static uint<<64>> of(string s) { return s.hash(); }

    /** Anything else: its own hash(). */
    public static <K> uint<<64>> of(K key) { return key.hash(); }

    /** Spreads the bits of x over the whole word (the splitmix64 finalizer). */
    public static uint<<64>> mix(uint<<64>> x)
    {
        uint<<64>> z = x + 11400714819323198485;
        z = (z ^ (z <<< -30)) * 13787848793156543929;
        z = (z ^ (z <<< -27)) * 10723151780598845931;
        return z ^ (z <<< -31);
    }

    @native("double_bits") static uint<<64>> doubleBits(double x) { }
    @native("float_bits") static uint<<64>> floatBits(float x) { }
}
