package seal.lang;

// The operators a class, struct or unique can define for itself, named for
// @overload (§46):
//
//   @overload(Operator.ADD)    public Vec2 plus(Vec2 other) { ... }     // a + b
//   @overload(Operator.NEGATE) public Vec2 negated() { ... }             // -a
//   @overload(Operator.INDEX)  public T get(int i) { ... }               // xs[i]
//   @overload(Operator.CAST)   public double toDouble() { ... }          // (double)a
//
// !=, >, <= and >= come from == and < when a type doesn't define them (§48).
enum Operator {
    ADD("+"),
    SUBTRACT("-"),
    NEGATE("-"),
    MULTIPLY("*"),
    POWER("**"),
    DIVIDE("/"),
    REMAINDER("%"),
    BIT_AND("&"),
    BIT_OR("|"),
    BIT_XOR("^"),
    BIT_NOT("~"),
    EQUALS("=="),
    NOT_EQUALS("!="),
    LESS("<"),
    GREATER(">"),
    LESS_EQUAL("<="),
    GREATER_EQUAL(">="),
    SHIFT("<<<"),
    SHIFT_ASSIGN("<<="),
    INDEX("[]"),
    INDEX_SET("[]="),
    CAST("(T)"),
    // Compound assignments are operators of their own, which change the object itself:
    // x += y doesn't come from + (§46).
    ADD_ASSIGN("+="),
    SUBTRACT_ASSIGN("-="),
    MULTIPLY_ASSIGN("*="),
    POWER_ASSIGN("**="),
    DIVIDE_ASSIGN("/="),
    REMAINDER_ASSIGN("%="),
    BIT_AND_ASSIGN("&="),
    BIT_OR_ASSIGN("|="),
    BIT_XOR_ASSIGN("^=");

    string sym;

    new(string s) { sym = s; }

    /** How the operator is written: "+" for ADD. */
    public string symbol() { return sym; }
}
