package seal.lang;

// Something that holds a resource, such as an open file, until it is closed,
// as in Java. try-with-resources closes it at the end of its block, however
// the block is left (§41.4):
//
//   try (FileWriter out = new FileWriter("report.txt")) {
//       out.println("total: " + total);
//   }
interface AutoCloseable {
    /** Releases the resource. Closing something already closed does nothing. */
    void close();
}
