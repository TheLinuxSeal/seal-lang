package seal.util;

import seal.util.function.BiConsumer;

// A map from keys to values, like Java's HashMap (§42.4).
//
//   HashMap<string, int> ages = new HashMap();
//   ages.put("ada", 36);
//   ages.get("ada")                      // 36; NoSuchElementException if absent
//   ages.getOrDefault("bob", 0)          // 0
//   for (string name : ages.keys()) { ... }
//   for (HashMap.Entry<string, int> e : ages.entries()) { e.getKey() ... }
//   ages.forEach((name, age) -> ...);
//
// Unlike Java's HashMap it keeps the order keys were first put in (like a
// LinkedHashMap), so it lists them the same way on every run. Keys need == and
// a hash: numbers, chars, bits and strings have them; a class hashes by
// identity unless it defines hash() (§42.4); a struct must define hash() and ==.
//
// Entries live in lists in the order they were added; a table of indexes,
// searched by linear probing from each key's hash, finds them.
class HashMap<K, V> {
    List<K> keyList;
    List<V> valueList;
    List<uint<<64>>> hashes;
    List<bit> removed;       // removed entries stay until the next rebuild
    List<int> table;         // per slot: 0 if empty, else the entry's index + 1
    int count;
    K blankKey;              // never assigned: what a removed entry's key and value become,
    V blankValue;            // so the map lets go of what they referred to

    public new() {
        keyList = new List();
        valueList = new List();
        hashes = new List();
        removed = new List();
        table = new List();
        rebuild(8);
    }

    public int size() { return count; }

    public bit isEmpty() { return count == 0; }

    /** Adds the key with this value, or replaces the value it has. */
    public void put(K key, V value) {
        uint<<64>> h = Hash.of(key);
        int i = find(key, h);
        if (i >= 0) {
            valueList.set(i, value);
            return;
        }
        if ((keyList.size() + 1) * 4 > table.size() * 3) {
            rebuild(count + 1);
        }
        keyList.add(key);
        valueList.add(value);
        hashes.add(h);
        removed.add(false);
        place(keyList.size() - 1, h);
        count++;
    }

    /** The key's value; throws a NoSuchElementException if the key isn't in the map. */
    public V get(K key) {
        int i = find(key, Hash.of(key));
        if (i < 0) { throw new NoSuchElementException("HashMap.get: the key isn't in the map"); }
        return valueList.get(i);
    }

    /** The key's value, or fallback if the key isn't in the map. */
    public V getOrDefault(K key, V fallback) {
        int i = find(key, Hash.of(key));
        return i < 0 ? fallback : valueList.get(i);
    }

    public bit containsKey(K key) { return find(key, Hash.of(key)) >= 0; }

    /** Removes the key and its value; true if it was there. */
    public bit remove(K key) {
        int i = find(key, Hash.of(key));
        if (i < 0) { return false; }
        removed.set(i, true);
        keyList.set(i, blankKey);
        valueList.set(i, blankValue);
        count--;
        return true;
    }

    public void clear() {
        keyList.clear();
        valueList.clear();
        hashes.clear();
        removed.clear();
        count = 0;
        rebuild(8);
    }

    /** The keys, in the order they were first put in. */
    public List<K> keys() {
        List<K> out = new List();
        for (int i = 0; i < keyList.size(); i++) {
            if (!removed.get(i)) { out.add(keyList.get(i)); }
        }
        return out;
    }

    /** The values, in the order of their keys. */
    public List<V> values() {
        List<V> out = new List();
        for (int i = 0; i < valueList.size(); i++) {
            if (!removed.get(i)) { out.add(valueList.get(i)); }
        }
        return out;
    }

    /** Each key with its value, in order. */
    public List<Entry<K, V>> entries() {
        List<Entry<K, V>> out = new List();
        for (int i = 0; i < keyList.size(); i++) {
            if (!removed.get(i)) { out.add(new Entry<K, V>(keyList.get(i), valueList.get(i))); }
        }
        return out;
    }

    /** Calls action with each key and its value, in order. */
    public void forEach(BiConsumer<K, V> action) {
        for (int i = 0; i < keyList.size(); i++) {
            if (!removed.get(i)) { action.accept(keyList.get(i), valueList.get(i)); }
        }
    }

    // ------------------------------------------------------------ inside

    /** The index of the key's entry, or -1. */
    int find(K key, uint<<64>> h) {
        int mask = table.size() - 1;
        int slot = (int)(h & (uint<<64>>)mask);
        while (true) {
            int e = table.get(slot);
            if (e == 0) { return -1; }
            int i = e - 1;
            if (!removed.get(i) && hashes.get(i) == h && keyList.get(i) == key) { return i; }
            slot = (slot + 1) & mask;
        }
    }

    /** Puts entry i in the first free slot from its hash. */
    void place(int i, uint<<64>> h) {
        int mask = table.size() - 1;
        int slot = (int)(h & (uint<<64>>)mask);
        while (table.get(slot) != 0) { slot = (slot + 1) & mask; }
        table.set(slot, i + 1);
    }

    /** Drops removed entries and makes a table with room for at least n entries. */
    void rebuild(int n) {
        int write = 0;
        for (int i = 0; i < keyList.size(); i++) {
            if (!removed.get(i)) {
                keyList.set(write, keyList.get(i));
                valueList.set(write, valueList.get(i));
                hashes.set(write, hashes.get(i));
                write++;
            }
        }
        while (keyList.size() > write) {
            keyList.removeLast();
            valueList.removeLast();
            hashes.removeLast();
        }
        removed.clear();
        for (int i = 0; i < write; i++) { removed.add(false); }
        int capacity = 8;
        while (capacity * 3 < n * 4 * 2) { capacity *= 2; } // at most 3/8 full after a rebuild
        table.clear();
        table.reserve(capacity);
        for (int i = 0; i < capacity; i++) { table.add(0); }
        for (int i = 0; i < write; i++) { place(i, hashes.get(i)); }
    }

    /** One key and its value, as entries() gives them, like Java's Map.Entry. */
    public static class Entry<A, B> {
        public A key;
        public B value;

        public new(A key, B value) { this.key = key; this.value = value; }

        public A getKey() { return key; }
        public B getValue() { return value; }
    }
}
