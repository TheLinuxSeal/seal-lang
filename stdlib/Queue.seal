// A first-in, first-out queue of T in a growable ring buffer. Queue is a
// class: create one with `new Queue()`; it is shared and freed automatically.
class Queue<T>
{
    array<T> items;   // a ring: the elements start at head and wrap around
    int head;
    int count;
    T blank;   // never assigned; used to clear slots

    public int size() { return count; }

    public bit isEmpty() { return count == 0; }

    /** Adds to the back. */
    public void push(T value)
    {
        if (count == items.length()) { items = unrolled(items.length() < 4 ? 8 : 2 * items.length()); }
        items[(head + count) % items.length()] = value;
        count++;
    }

    /** Removes from the front. */
    public T pop()
    {
        if (count == 0) { throw new NoSuchElementException("pop on an empty Queue"); }
        T value = items[head];
        items[head] = blank;
        head = (head + 1) % items.length();
        count--;
        return value;
    }

    /** The front element, without removing it. */
    public T peek()
    {
        if (count == 0) { throw new NoSuchElementException("peek on an empty Queue"); }
        return items[head];
    }

    public void clear()
    {
        while (count > 0) { pop(); }
        head = 0;
    }

    /** The elements in order, from the front, in a new array of n places (n >= size()). */
    array<T> unrolled(int n)
    {
        array<T> out = new array<T>(n);
        for (int i = 0; i < count; i++) { out[i] = items[(head + i) % items.length()]; }
        head = 0;
        return out;
    }
}
