import seal.io.Files;
import seal.io.Reader;
import seal.util.List;

// Strings of 16-bit characters (§39).
//
//   string<<N>>  holds up to N characters inline. It never allocates.
//   string       (the bare shape) holds any number, in a buffer on the heap.
//
// Strings are immutable, as Java's: no method changes one. Methods such as
// substring, trim and toUpper return a new string, `s += x` stores a new
// string in s, and StringBuilder builds text a piece at a time.
//
// On the JVM a string is a java.lang.String (docs/JVM.md §8.2): reading size
// is its length(), and the methods marked @jvm are the runtime methods named,
// mostly its Strings'. A method here that changes a string being made (put,
// room) returns the new String there.
struct string<<>>
struct string<<int N>> {
    int size;
    array<char><<N>> chars<<int N>>;

    // ------------------------------------------------------------ construction

    public new() { }

    /**
     * A fixed string becomes a bare one wherever a bare string is wanted:
     * `string s = fixed;`, passing it to a `string` parameter, returning it.
     */
    @implicit
    public new<<>>(string<<int K>> other) {
        room(other.length());
        put(other);
    }

    /** The characters of an array, as Java's new String(char[]). */
    public new<<>>(array<char> chars) {
        room(chars.length());
        for (int i = 0; i < chars.length(); i++) { put(chars[i]); }
    }

    /** count characters of an array, from offset on, as Java's new String(char[], offset, count). */
    public new<<>>(array<char> chars, int offset, int count) {
        if (offset < 0 || count < 0 || offset > chars.length() - count) {
            throw new IndexOutOfBoundsException("offset " + offset + " and count " + count + " out of range for an array of length " + chars.length());
        }
        room(count);
        for (int i = 0; i < count; i++) { put(chars[offset + i]); }
    }

    /** The n characters the last file operation produced, as a new bare string (§42.1). */
    @jvm("Natives.takeText") private<Files, Reader> static string takeText(int n);

    // ------------------------------------------------------------ formatting (§42.6)

    /**
     * Text from a format and values, as Java's String.format: string.format("%-8s %6.2f", name, price).
     * Up to eight values; Format (§42.6) lists the specifiers.
     */
    public static string format(string fmt) { Format fm = new Format(fmt); return fm.finish(); }
    public static <A> string format(string fmt, A a) { Format fm = new Format(fmt); fm.arg(a); return fm.finish(); }
    public static <A, B> string format(string fmt, A a, B b) { Format fm = new Format(fmt); fm.arg(a); fm.arg(b); return fm.finish(); }
    public static <A, B, C> string format(string fmt, A a, B b, C c) { Format fm = new Format(fmt); fm.arg(a); fm.arg(b); fm.arg(c); return fm.finish(); }
    public static <A, B, C, D> string format(string fmt, A a, B b, C c, D d) { Format fm = new Format(fmt); fm.arg(a); fm.arg(b); fm.arg(c); fm.arg(d); return fm.finish(); }
    public static <A, B, C, D, E> string format(string fmt, A a, B b, C c, D d, E e) { Format fm = new Format(fmt); fm.arg(a); fm.arg(b); fm.arg(c); fm.arg(d); fm.arg(e); return fm.finish(); }
    public static <A, B, C, D, E, F> string format(string fmt, A a, B b, C c, D d, E e, F f) { Format fm = new Format(fmt); fm.arg(a); fm.arg(b); fm.arg(c); fm.arg(d); fm.arg(e); fm.arg(f); return fm.finish(); }
    public static <A, B, C, D, E, F, G> string format(string fmt, A a, B b, C c, D d, E e, F f, G g) { Format fm = new Format(fmt); fm.arg(a); fm.arg(b); fm.arg(c); fm.arg(d); fm.arg(e); fm.arg(f); fm.arg(g); return fm.finish(); }
    public static <A, B, C, D, E, F, G, H> string format(string fmt, A a, B b, C c, D d, E e, F f, G g, H h) { Format fm = new Format(fmt); fm.arg(a); fm.arg(b); fm.arg(c); fm.arg(d); fm.arg(e); fm.arg(f); fm.arg(g); fm.arg(h); return fm.finish(); }

    /** A bare string holding n characters read from memory. */
    public static string fromChars(addr<char> chars, int n) {
        string s;
        s.room(n);
        for (int i = 0; i < n; i++) { s.put(&(chars + (int<<64>>)i * 16)); }
        return s;
    }

    // ------------------------------------------------------------ size

    public int length() { return size; }

    public bit isEmpty() { return size == 0; }

    /** The most characters this string can hold. */
    public int maxLength<<int N>>() { return N; }

    // ------------------------------------------------------------ characters

    public char charAt(int i) {
        if (i < 0 || i >= size) { throw new IndexOutOfBoundsException("string index " + i + " out of range for length " + size); }
        return at(i);
    }

    /** The character at i, which is in range. */
    @jvm("Strings.at") char at(int i);

    /** The characters as an array of exactly length() chars. */
    public array<char> toCharArray<<>>() {
        array<char> out = new array<char>(size);
        for (int i = 0; i < size; i++) { out[i] = charAt(i); }
        return out;
    }

    /**
     * The characters as an array of the string's capacity; places past
     * length() are 0. For a literal the two are equal: "abc".toCharArray()
     * is an array<char><<3>>.
     */
    public array<char><<N>> toCharArray<<int N>>() {
        array<char><<N>> result;
        for (int i = 0; i < length(); i++) { result[i] = at(i); }
        return result;
    }

    // ------------------------------------------------------------ making strings
    //
    // put and room add to a string being made, before anything else sees it:
    // a local of a method here that makes and returns a new string, and that
    // has room for what it adds.

    @jvm("Strings.put") void put(char c);
    @jvm("Strings.put") void put(string other);
    @jvm("Strings.put") void put(string<<int K>> other);

    /** Makes room for n characters, for a string about to add them. */
    @jvm("Strings.room") void room<<>>(int n);

    /** Joins two fixed strings into one whose capacity is the sum of theirs. */
    @overload(Operator.ADD)
    public string<<N + K>> add<<int N>>(string<<int K>> other) {
        string<<N + K>> result;
        for (int i = 0; i < size; i++) { result.put(at(i)); }
        result.put(other);
        return result;
    }

    // Joining with a bare string, a char, or a number's text gives a bare string:
    // "total: " + n, name + "!", fixed + bare. (`add` is guarded per shape, as the
    // fixed + fixed version above is, so each comes in a <<int N>> and a <<>> form.)

    @overload(Operator.ADD) public string add<<int N>>(string other) { return join(other); }
    @overload(Operator.ADD) public string add<<int N>>(int x) { return join(Integer.toString(x)); }
    @overload(Operator.ADD) public string add<<int N>>(size x) { return join(Integer.toString((int)x)); }
    @overload(Operator.ADD) public string add<<int N>>(int<<size W>> x) { return join(Integer.toString((int<<64>>)x)); }
    @overload(Operator.ADD) public string add<<int N>>(uint<<size W>> x) { return join(Integer.toString((uint<<64>>)x)); }
    @overload(Operator.ADD) public string add<<int N>>(double x) { return join(Double.toString(x)); }
    @overload(Operator.ADD) public string add<<int N>>(float x) { return join(Float.toString(x)); }
    @overload(Operator.ADD) public string add<<int N>>(fixed<<size A, size B>> x) { return join(Fixed.toString(x)); }
    @overload(Operator.ADD) public string add<<int N>>(ufixed<<size A, size B>> x) { return join(Fixed.toString(x)); }
    @overload(Operator.ADD) public string add<<int N>>(bit x) { if (x) { return join("true"); } return join("false"); }
    @overload(Operator.ADD) public string add<<int N>>(char c) { string r = copy(); r.put(c); return r; }

    @overload(Operator.ADD) public string add<<>>(string other) { return join(other); }
    @overload(Operator.ADD) public string add<<>>(string<<int K>> other) { return join(other); }
    @overload(Operator.ADD) public string add<<>>(int x) { return join(Integer.toString(x)); }
    @overload(Operator.ADD) public string add<<>>(size x) { return join(Integer.toString((int)x)); }
    @overload(Operator.ADD) public string add<<>>(int<<size W>> x) { return join(Integer.toString((int<<64>>)x)); }
    @overload(Operator.ADD) public string add<<>>(uint<<size W>> x) { return join(Integer.toString((uint<<64>>)x)); }
    @overload(Operator.ADD) public string add<<>>(double x) { return join(Double.toString(x)); }
    @overload(Operator.ADD) public string add<<>>(float x) { return join(Float.toString(x)); }
    @overload(Operator.ADD) public string add<<>>(fixed<<size A, size B>> x) { return join(Fixed.toString(x)); }
    @overload(Operator.ADD) public string add<<>>(ufixed<<size A, size B>> x) { return join(Fixed.toString(x)); }
    @overload(Operator.ADD) public string add<<>>(bit x) { if (x) { return join("true"); } return join("false"); }
    @overload(Operator.ADD) public string add<<>>(char c) { string r = this; r.put(c); return r; }

    // s += x stores s + x in s (§46). That is a new string, which may share s's
    // buffer: see put. (A compound operator is its own, so string declares it.)
    @overload(Operator.ADD_ASSIGN) public void addAssign<<>>(string other) { put(other); }
    @overload(Operator.ADD_ASSIGN) public void addAssign<<>>(string<<int K>> other) { put(other); }
    @overload(Operator.ADD_ASSIGN) public void addAssign<<>>(int x) { put(Integer.toString(x)); }
    @overload(Operator.ADD_ASSIGN) public void addAssign<<>>(int<<size W>> x) { put(Integer.toString((int<<64>>)x)); }
    @overload(Operator.ADD_ASSIGN) public void addAssign<<>>(uint<<size W>> x) { put(Integer.toString((uint<<64>>)x)); }
    @overload(Operator.ADD_ASSIGN) public void addAssign<<>>(double x) { put(Double.toString(x)); }
    @overload(Operator.ADD_ASSIGN) public void addAssign<<>>(float x) { put(Float.toString(x)); }
    @overload(Operator.ADD_ASSIGN) public void addAssign<<>>(fixed<<size A, size B>> x) { put(Fixed.toString(x)); }
    @overload(Operator.ADD_ASSIGN) public void addAssign<<>>(ufixed<<size A, size B>> x) { put(Fixed.toString(x)); }
    @overload(Operator.ADD_ASSIGN) public void addAssign<<>>(bit x) { if (x) { put("true"); } else { put("false"); } }
    @overload(Operator.ADD_ASSIGN) public void addAssign<<>>(char c) { put(c); }

    string join(string text) {
        string r = this;
        r.put(text);
        return r;
    }

    // ------------------------------------------------------------ comparison

    @overload(Operator.EQUALS)
    @jvm("Strings.equals")
    public bit equals(string other);

    @overload(Operator.EQUALS)
    @jvm("Strings.equals")
    public bit equals(string<<int K>> other);

    /** Negative, zero or positive as this string sorts before, equal to, or after the other. */
    @jvm("Strings.compare") public int compare(string other);

    @jvm("Strings.compare") public int compare(string<<int K>> other);

    @overload(Operator.LESS)
    public bit less(string other) { return compare(other) < 0; }

    @overload(Operator.LESS)
    public bit less(string<<int K>> other) { return compare(other) < 0; }

    public bit startsWith(string prefix) {
        if (prefix.length() > size) { return false; }
        for (int i = 0; i < prefix.length(); i++) {
            if (charAt(i) != prefix.charAt(i)) { return false; }
        }
        return true;
    }

    public bit endsWith(string suffix) {
        int n = suffix.length();
        if (n > size) { return false; }
        for (int i = 0; i < n; i++) {
            if (charAt(size - n + i) != suffix.charAt(i)) { return false; }
        }
        return true;
    }

    // ------------------------------------------------------------ searching

    /** Index of the first c, or -1. */
    public int indexOf(char c) {
        for (int i = 0; i < size; i++) {
            if (charAt(i) == c) { return i; }
        }
        return -1;
    }

    public bit contains(char c) { return indexOf(c) >= 0; }

    /** Index of the last c, or -1. */
    public int lastIndexOf(char c) {
        for (int i = size - 1; i >= 0; i--) {
            if (charAt(i) == c) { return i; }
        }
        return -1;
    }

    /** Index of the first place `part` starts, or -1 ("" is found at 0). */
    public int indexOf(string part) {
        int n = part.length();
        for (int i = 0; i + n <= size; i++) {
            int k = 0;
            while (k < n && charAt(i + k) == part.charAt(k)) { k++; }
            if (k == n) { return i; }
        }
        return -1;
    }

    public bit contains(string part) { return indexOf(part) >= 0; }

    // ------------------------------------------------------------ splitting

    /** The pieces between separators, empty ones included: "a,,b" gives "a", "", "b". */
    public List<string> split(char separator) {
        List<string> parts = new List();
        int start = 0;
        for (int i = 0; i < size; i++) {
            if (charAt(i) == separator) {
                parts.add(substring(start, i));
                start = i + 1;
            }
        }
        parts.add(substring(start, size));
        return parts;
    }

    /**
     * The lines, without their line ends (\n or \r\n), as in Java's lines(): a final line
     * end doesn't start another, empty line, and "" has no lines.
     */
    public List<string> lines() {
        List<string> out = new List();
        int start = 0;
        for (int i = 0; i < size; i++) {
            if (charAt(i) == '\n') {
                int end = i > start && charAt(i - 1) == '\r' ? i - 1 : i;
                out.add(substring(start, end));
                start = i + 1;
            }
        }
        if (start < size) {
            out.add(substring(start, size));
        }
        return out;
    }

    /** Without the spaces and control characters at either end. */
    public string trim() {
        int from = 0;
        int to = size;
        while (from < to && charAt(from) <= ' ') { from++; }
        while (to > from && charAt(to - 1) <= ' ') { to--; }
        return substring(from, to);
    }

    // ------------------------------------------------------------ conversion

    /** Characters from (inclusive) to to (exclusive), as a new bare string. */
    public string substring(int from, int to) {
        if (from < 0 || to > size || from > to) { throw new IndexOutOfBoundsException("substring(" + from + ", " + to + ") out of range for length " + size); }
        return slice(from, to);
    }

    /** substring's characters, which are in range. */
    @jvm("Strings.substring") string slice(int from, int to);

    /** The same text as a bare string: for a fixed string, (string)s. */
    public string copy() { return substring(0, size); }

    /** The string with every letter in upper case: s = s.toUpper(); as Java's toUpperCase. */
    @jvm("Strings.toUpper") public string<<N>> toUpper<<int N>>();
    @jvm("Strings.toUpper") public string toUpper<<>>();

    /** The string with every letter in lower case, as Java's toLowerCase. */
    @jvm("Strings.toLower") public string<<N>> toLower<<int N>>();
    @jvm("Strings.toLower") public string toLower<<>>();

    /** The string with every old character replaced by new, as Java's replace(char, char). */
    @jvm("Strings.replace") public string replace(char old, char replacement);

    /** The string n times over, as Java's repeat. */
    public string repeat(int n) {
        if (n < 0) { throw new IllegalArgumentException("repeat count is negative: " + n); }
        return times(n);
    }

    @jvm("Strings.repeat") string times(int n);

    /** Parses an optionally negative decimal integer; fails on anything else. */
    public int<<64>> toInt() {
        if (size == 0) { throw new NumberFormatException("cannot parse an empty string as an integer"); }
        int i = 0;
        bit negative = false;
        if (charAt(0) == '-') {
            negative = true;
            i = 1;
            if (size == 1) { throw new NumberFormatException("cannot parse \"-\" as an integer"); }
        }
        int<<64>> value = 0;
        for (; i < size; i++) {
            char c = charAt(i);
            if (!Char.isDigit(c)) { throw new NumberFormatException("not a decimal integer: \"" + copy() + "\""); }
            value = value * 10 + (int<<64>>)Char.digitValue(c);
        }
        if (negative) { return -value; }
        return value;
    }

    /** FNV-1a hash of the characters. */
    public uint<<64>> hash() {
        uint<<64>> h = 14695981039346656037;
        for (int i = 0; i < size; i++) {
            h = (h ^ (uint<<64>>)charAt(i)) * 1099511628211;
        }
        return h;
    }
}
