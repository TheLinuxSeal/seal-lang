// A growable list of T, like Java's ArrayList. List is a class: variables
// refer to a shared list, created with `new List()`, and freed automatically
// when the last reference goes away.
//
// Elements are copied in and out by value (a class element is a handle, so
// the list shares the object). indexOf, contains and sort need T to support
// == and < respectively; that is checked when they are used.
class List<T>
{
    addr<T> items;
    int count;
    int capacity;
    // Never assigned: an "empty" T (null, zero) used to clear slots, so a
    // removed element gives up its reference straight away.
    T blank;

    public int size() { return count; }

    public bit isEmpty() { return count == 0; }

    public T get(int i)
    {
        check(i);
        return &(items + offset(i));
    }

    public void set(int i, T value)
    {
        check(i);
        &(items + offset(i)) = value;
    }

    public void add(T value)
    {
        reserve(count + 1);
        &(items + offset(count)) = value;
        count++;
    }

    public T first()
    {
        check(0);
        return &items;
    }

    public T last()
    {
        check(count - 1);
        return &(items + offset(count - 1));
    }

    public T removeLast()
    {
        if (count == 0) { throw new NoSuchElementException("removeLast on an empty List"); }
        count--;
        T value = &(items + offset(count));
        &(items + offset(count)) = blank;
        return value;
    }

    /** Inserts at index i (0 to size()), shifting later elements up. */
    public void insert(int i, T value)
    {
        if (i < 0 || i > count) { throw new IndexOutOfBoundsException("List insert index " + i + " out of range for size " + count); }
        reserve(count + 1);
        for (int j = count; j > i; j--) {
            &(items + offset(j)) = &(items + offset(j - 1));
        }
        &(items + offset(i)) = value;
        count++;
    }

    /** Removes and returns the element at i, shifting later elements down. */
    public T removeAt(int i)
    {
        check(i);
        T value = &(items + offset(i));
        for (int j = i; j < count - 1; j++) {
            &(items + offset(j)) = &(items + offset(j + 1));
        }
        count--;
        &(items + offset(count)) = blank;
        return value;
    }

    /** Removes every element. */
    public void clear()
    {
        for (int i = 0; i < count; i++) { &(items + offset(i)) = blank; }
        count = 0;
    }

    public void swap(int i, int j)
    {
        check(i);
        check(j);
        T t = &(items + offset(i));
        &(items + offset(i)) = &(items + offset(j));
        &(items + offset(j)) = t;
    }

    public void reverse()
    {
        int i = 0;
        int j = count - 1;
        while (i < j) {
            swap(i, j);
            i++;
            j--;
        }
    }

    /** Index of the first element equal to value, or -1. */
    public int indexOf(T value)
    {
        for (int i = 0; i < count; i++) {
            if (&(items + offset(i)) == value) { return i; }
        }
        return -1;
    }

    public bit contains(T value) { return indexOf(value) >= 0; }

    /** Sorts ascending with <, in place (heapsort: O(n log n), not stable). */
    public void sort()
    {
        for (int start = count / 2 - 1; start >= 0; start--) { siftDown(start, count); }
        for (int end = count - 1; end > 0; end--) {
            swap(0, end);
            siftDown(0, end);
        }
    }

    /**
     * Sorts in place in the order `cmp` gives, keeping equal elements in their
     * order (merge sort: O(n log n), stable): list.sort((a, b) -> a.age - b.age).
     */
    public void sort(Comparator<T> cmp)
    {
        List<T> buffer = new List();
        buffer.reserve(count);
        for (int i = 0; i < count; i++) { buffer.add(get(i)); }
        for (int width = 1; width < count; width *= 2) {
            for (int lo = 0; lo < count; lo += 2 * width) {
                int mid = lo + width;
                int hi = lo + 2 * width;
                if (mid > count) { mid = count; }
                if (hi > count) { hi = count; }
                // Merge [lo, mid) and [mid, hi) of this list into the buffer.
                int a = lo;
                int b = mid;
                for (int k = lo; k < hi; k++) {
                    if (a < mid && (b >= hi || cmp.compare(get(b), get(a)) >= 0)) {
                        buffer.set(k, get(a));
                        a++;
                    } else {
                        buffer.set(k, get(b));
                        b++;
                    }
                }
            }
            for (int i = 0; i < count; i++) { set(i, buffer.get(i)); }
        }
    }

    /** Calls `action` with each element in order: list.forEach(x -> System.stdout.println(x)). */
    public void forEach(Consumer<T> action)
    {
        for (int i = 0; i < count; i++) { action.accept(get(i)); }
    }

    /** Removes the elements `test` accepts, keeping the order of the rest; true if any went. */
    public bit removeIf(Predicate<T> test)
    {
        int kept = 0;
        for (int i = 0; i < count; i++) {
            T x = get(i);
            if (!test.test(x)) {
                set(kept, x);
                kept++;
            }
        }
        bit removed = kept < count;
        while (count > kept) { removeLast(); }
        return removed;
    }

    /** The elements, as a new array. */
    public array<T> toArray()
    {
        array<T> out = new array<T>(count);
        for (int i = 0; i < count; i++) { out[i] = get(i); }
        return out;
    }

    /** Makes room for at least n elements. */
    public void reserve(int n)
    {
        if (n <= capacity) { return; }
        int c = capacity * 2;
        if (c < 8) { c = 8; }
        if (c < n) { c = n; }
        addr<T> fresh = new<T>(c);
        for (int i = 0; i < count; i++) {
            &(fresh + offset(i)) = &(items + offset(i));
            &(items + offset(i)) = blank;
        }
        delete items;
        items = fresh;
        capacity = c;
    }

    delete()
    {
        clear();
        delete items;
    }

    void siftDown(int root, int end)
    {
        int r = root;
        while (true) {
            int child = 2 * r + 1;
            if (child >= end) { return; }
            if (child + 1 < end && at(child) < at(child + 1)) { child++; }
            if (at(r) < at(child)) {
                swap(r, child);
                r = child;
            } else {
                return;
            }
        }
    }

    T at(int i) { return &(items + offset(i)); }

    int<<64>> offset(int i) { return (int<<64>>)i * sizeof(T); }

    void check(int i)
    {
        if (i < 0 || i >= count) { throw new IndexOutOfBoundsException("List index " + i + " out of range for size " + count); }
    }
}
