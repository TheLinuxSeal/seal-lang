// Tests and conversions for characters (char, a UTF-16 code unit; ASCII range).
struct Char
{
    public static bit isDigit(char c) { return c >= '0' && c <= '9'; }
    public static bit isUpper(char c) { return c >= 'A' && c <= 'Z'; }
    public static bit isLower(char c) { return c >= 'a' && c <= 'z'; }
    public static bit isLetter(char c) { return isUpper(c) || isLower(c); }
    public static bit isLetterOrDigit(char c) { return isLetter(c) || isDigit(c); }
    public static bit isSpace(char c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r'; }

    public static char toUpper(char c)
    {
        if (isLower(c)) { return (char)(c - 'a' + 'A'); }
        return c;
    }

    public static char toLower(char c)
    {
        if (isUpper(c)) { return (char)(c - 'A' + 'a'); }
        return c;
    }

    /** The value of a decimal digit character, or -1. */
    public static int digitValue(char c)
    {
        if (isDigit(c)) { return c - '0'; }
        return -1;
    }
}
