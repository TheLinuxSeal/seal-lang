// Text for double values.
struct Double
{
    /** The shortest decimal text that reads back as the same double, as in Java: 0.1, 1.0E10, NaN. */
    @jvm("Strings.of")
    public static string toString(double x)
    {
        addr<char> buf = new<char>(32);
        int n = text(x, buf);
        string s = string.fromChars(buf, n);
        delete buf;
        return s;
    }

    @native("text_double") static int text(double x, addr<char> buf) { }
}
