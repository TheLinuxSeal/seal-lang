import seal.util.Comparator;
import seal.util.List;

// An array whose length is chosen when it is made (§21.3):
//
//   array<int> xs = new array<int>(n);
//   xs[0] = 7;
//   array<int> ys = [1, 2, 3];
//   for (int y : ys) { ... }
//
// (array<T><<N>>, whose length is part of its type, is the compiler's own
// fixed array, a value; its methods are in FixedArray.)
//
// An array is a unique: it can't be copied (use copy()), and passing one to a
// method lends it, so the method works on the caller's array: fill(xs) fills
// it. Returning one from a method moves it out. It is freed when it goes out
// of scope. An index outside it throws an IndexOutOfBoundsException.
//
// Elements are copied in and out, so they can't be uniques themselves: no
// array<array<int>>, but an array<array<int><<3>>> is fine, as fixed arrays
// are values.
//
// array<T> is the language's own type, which classes may hold although it is
// a unique: it has no destructor of its own, as its memory goes with it. On
// the JVM it is a Java array, whose length len reads, and the methods marked
// @jvm are what the JVM backend generates for them; the rest compile as they
// are. This is its implementation on the VM, and the one place in the library
// that still uses pointers. The collections (List, Queue, IntMap, HashMap,
// StringBuilder) are built on it.
unique array<T>
{
    addr<T> items;   // len elements on the heap
    int len;

    public new() { }

    /** An array of n default elements (0, false, null, "", ...). */
    public new(int n)
    {
        if (n < 0) { throw new IllegalArgumentException("an array can't have length " + n); }
        allocate(n);
    }

    /** Room for n elements, each a default T. */
    @jvm("array.allocate")
    void allocate(int n)
    {
        items = new<T>(n > 0 ? n : 1);
        len = n;
        T blank; // a default T for each element
        for (int i = 0; i < n; i++) { &(items + (int<<64>>)i * sizeof(T)) = blank; }
    }

    public int length() { return len; }

    /** Where the elements are, for the buffer behind bare strings on the VM (StringChars). */
    private<string> addr<T> start() { return items; }

    public bit isEmpty() { return length() == 0; }

    @overload(Operator.INDEX)
    @jvm("array.get")
    public T get(int i)
    {
        check(i);
        return &(items + (int<<64>>)i * sizeof(T));
    }

    @overload(Operator.INDEX_SET)
    @jvm("array.set")
    public void set(int i, T value)
    {
        check(i);
        &(items + (int<<64>>)i * sizeof(T)) = value;
    }

    void check(int i)
    {
        if (i < 0 || i >= length()) {
            throw new IndexOutOfBoundsException("index " + i + " out of range for an array of length " + length());
        }
    }

    // ------------------------------------------------------------ whole arrays

    /** Sets every element to value. */
    public void fill(T value)
    {
        for (int i = 0; i < length(); i++) { set(i, value); }
    }

    /** A new array with the same elements. */
    public array<T> copy()
    {
        array<T> out = new array<T>(length());
        for (int i = 0; i < length(); i++) { out.set(i, get(i)); }
        return out;
    }

    /**
     * A new array of n elements: this one's first n, and default ones after
     * them if it is shorter, as Java's Arrays.copyOf. A list grows with
     * `items = items.copyOf(2 * items.length());`.
     */
    public array<T> copyOf(int n)
    {
        array<T> out = new array<T>(n);
        int k = n < length() ? n : length();
        for (int i = 0; i < k; i++) { out.set(i, get(i)); }
        return out;
    }

    /** The elements from (inclusive) to to (exclusive), as a new array. */
    public array<T> slice(int from, int to)
    {
        if (from < 0 || to > length() || from > to) {
            throw new IndexOutOfBoundsException("slice(" + from + ", " + to + ") out of range for an array of length " + length());
        }
        array<T> out = new array<T>(to - from);
        for (int i = from; i < to; i++) { out.set(i - from, get(i)); }
        return out;
    }

    public List<T> toList()
    {
        List<T> out = new List();
        out.reserve(length());
        for (int i = 0; i < length(); i++) { out.add(get(i)); }
        return out;
    }

    /** Index of the first element == value, or -1. */
    public int indexOf(T value)
    {
        for (int i = 0; i < length(); i++) {
            if (get(i) == value) { return i; }
        }
        return -1;
    }

    public bit contains(T value) { return indexOf(value) >= 0; }

    public void swap(int i, int j)
    {
        T t = get(i);
        set(i, get(j));
        set(j, t);
    }

    public void reverse()
    {
        int i = 0;
        int j = length() - 1;
        while (i < j) {
            swap(i, j);
            i++;
            j--;
        }
    }

    /** Sorts ascending with <, in place (heapsort: O(n log n), not stable). */
    public void sort()
    {
        int n = length();
        for (int start = n / 2 - 1; start >= 0; start--) { siftDown(start, n); }
        for (int end = n - 1; end > 0; end--) {
            swap(0, end);
            siftDown(0, end);
        }
    }

    void siftDown(int start, int end)
    {
        int root = start;
        while (root * 2 + 1 < end) {
            int child = root * 2 + 1;
            if (child + 1 < end && get(child) < get(child + 1)) { child++; }
            if (!(get(root) < get(child))) { return; }
            swap(root, child);
            root = child;
        }
    }

    /** Sorts in the order cmp gives, keeping equal elements in order (merge sort: O(n log n), stable). */
    public void sort(Comparator<T> cmp)
    {
        List<T> sorted = toList();
        sorted.sort(cmp);
        for (int i = 0; i < length(); i++) { set(i, sorted.get(i)); }
    }

    // Frees the elements' memory on the VM; the JVM's garbage collector does this itself.
    delete()
    {
        T blank;
        for (int i = 0; i < len; i++) { &(items + (int<<64>>)i * sizeof(T)) = blank; } // lets go of what they refer to
        delete items;
    }
}
