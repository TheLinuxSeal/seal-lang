// The root of everything that can be thrown and caught (§41.4), as in Java:
//
//   throw new IllegalArgumentException("negative size");
//   try { ... } catch (IllegalArgumentException e) { System.stdout.println(e.getMessage()); }
//
// Exceptions are unchecked: methods don't list what they throw.
class Exception
{
    string message;

    public new() { }
    public new(string m) { message = m; }

    /** The text given when the exception was made; empty if none. */
    public string getMessage() { return message; }
}
