// A hash map from 64-bit integer keys to V (open addressing, linear probing).
// IntMap is a class: create one with `new IntMap()`; it is shared and freed
// automatically.
class IntMap<V>
{
    addr<int<<64>>> keyData;
    addr<V> valueData;
    // One bit per slot: whether it holds an entry. Bit-addressed memory makes this compact.
    addr<bit> usedBits;
    int count;
    int capacity;
    V blank;   // never assigned; used to clear removed values

    public int size() { return count; }

    public bit isEmpty() { return count == 0; }

    /** Adds or replaces the value for key. */
    public void put(int<<64>> key, V value)
    {
        if ((count + 1) * 4 > capacity * 3) { grow(); }
        int i = find(key);
        if (!used(i)) {
            &(usedBits + i) = true;
            &(keyData + (int<<64>>)i * 64) = key;
            count++;
        }
        &(valueData + (int<<64>>)i * sizeof(V)) = value;
    }

    public bit has(int<<64>> key)
    {
        if (capacity == 0) { return false; }
        return used(find(key));
    }

    /** The value for key; fails if there is none. */
    public V get(int<<64>> key)
    {
        if (!has(key)) { throw new NoSuchElementException("IntMap.get: no key " + key); }
        return &(valueData + (int<<64>>)find(key) * sizeof(V));
    }

    /** Removes key; returns whether it was present. */
    public bit remove(int<<64>> key)
    {
        if (!has(key)) { return false; }
        int hole = find(key);
        &(usedBits + hole) = false;
        &(valueData + (int<<64>>)hole * sizeof(V)) = blank;
        count--;
        // Shift later entries of the same probe run back into the hole.
        int j = hole;
        while (true) {
            j = (j + 1) & (capacity - 1);
            if (!used(j)) { return true; }
            int home = slotOf(keyAt(j));
            bit stays;
            if (hole <= j) { stays = hole < home && home <= j; } else { stays = hole < home || home <= j; }
            if (!stays) {
                &(keyData + (int<<64>>)hole * 64) = keyAt(j);
                &(valueData + (int<<64>>)hole * sizeof(V)) = &(valueData + (int<<64>>)j * sizeof(V));
                &(valueData + (int<<64>>)j * sizeof(V)) = blank;
                &(usedBits + hole) = true;
                &(usedBits + j) = false;
                hole = j;
            }
        }
    }

    /** All keys, in no particular order. */
    public List<int<<64>>> keys()
    {
        List<int<<64>>> out = new List();
        out.reserve(count);
        for (int i = 0; i < capacity; i++) {
            if (used(i)) { out.add(keyAt(i)); }
        }
        return out;
    }

    public void clear()
    {
        for (int i = 0; i < capacity; i++) {
            &(usedBits + i) = false;
            &(valueData + (int<<64>>)i * sizeof(V)) = blank;
        }
        count = 0;
    }

    delete()
    {
        clear();
        delete keyData;
        delete valueData;
        delete usedBits;
    }

    /** The slot holding key, or the empty slot where it would go. */
    int find(int<<64>> key)
    {
        int i = slotOf(key);
        while (used(i) && keyAt(i) != key) { i = (i + 1) & (capacity - 1); }
        return i;
    }

    int slotOf(int<<64>> key)
    {
        uint<<64>> h = (uint<<64>>)key * 11400714819323198485;
        h = h ^ (h <<< -29);
        return (int)(h & (uint<<64>>)(capacity - 1));
    }

    bit used(int i) { return &(usedBits + i); }

    int<<64>> keyAt(int i) { return &(keyData + (int<<64>>)i * 64); }

    void grow()
    {
        addr<int<<64>>> oldKeys = keyData;
        addr<V> oldValues = valueData;
        addr<bit> oldUsed = usedBits;
        int oldCapacity = capacity;
        capacity = capacity * 2;
        if (capacity < 16) { capacity = 16; }
        keyData = new<int<<64>>>(capacity);
        valueData = new<V>(capacity);
        usedBits = new<bit>(capacity);
        count = 0;
        for (int i = 0; i < oldCapacity; i++) {
            if (&(oldUsed + i)) {
                put(&(oldKeys + (int<<64>>)i * 64), &(oldValues + (int<<64>>)i * sizeof(V)));
                &(oldValues + (int<<64>>)i * sizeof(V)) = blank;
            }
        }
        delete oldKeys;
        delete oldValues;
        delete oldUsed;
    }
}
